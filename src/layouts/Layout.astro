<style is:global>
	/* -------------------------------------------------------------
	   DESIGN SYSTEM & CSS THEMES (TRI-LENS SYSTEM)
	   ------------------------------------------------------------- */
	
	:root {
		/* --- FRONTEND THEME: Velvet black, violet & purple gradient --- */
		--fe-bg: #06030D;
		--fe-surface: rgba(139, 92, 246, 0.04);
		--fe-surface-border: rgba(139, 92, 246, 0.12);
		--fe-primary: #8B5CF6; /* Violet */
		--fe-secondary: #7000FF; /* Purple */
		--fe-accent: #C084FC; /* Neon violet / purple glow */
		--fe-text: #F3F1F8;
		--fe-text-muted: #A39EBA;
		--fe-font-sans: 'Outfit', sans-serif;
		
		/* --- BACKEND THEME: Monospace matrix terminal --- */
		--be-bg: #06090F;
		--be-surface: #0C1017;
		--be-surface-border: #1F242C;
		--be-primary: #00F5A0;
		--be-secondary: #00E5FF;
		--be-accent: #FFB86C;
		--be-text: #E1E6EC;
		--be-text-muted: #6E7681;
		--be-font-mono: 'JetBrains Mono', monospace;



		/* --- SYSTEMS THEME: Carbon navy with digital blue/purple devops gradients --- */
		--sys-bg: #070B13;
		--sys-surface: rgba(255, 255, 255, 0.03);
		--sys-surface-border: rgba(255, 255, 255, 0.08);
		--sys-primary: #0088FF;
		--sys-secondary: #8B5CF6;
		--sys-accent: #00F5A0;
		--sys-text: #F1F5F9;
		--sys-text-muted: #94A3B8;
		--sys-font-sans: 'Inter', sans-serif;

		/* --- ACTIVE SYSTEM TOKENS (Mapped dynamically via JS data-theme) --- */
		--font-family: var(--fe-font-sans);
		--bg-color: var(--fe-bg);
		--text-color: var(--fe-text);
		--text-muted: var(--fe-text-muted);
		--surface-color: var(--fe-surface);
		--border-color: var(--fe-surface-border);
		--accent-color: var(--fe-primary);
		--secondary-color: var(--fe-secondary);
		--glow-intensity: 1;
		
		/* CSS custom variables that the Frontend Playground can update */
		--user-hue: 0deg;
		--user-radius: 12px;
		--user-scale: 1;

		font-size: calc(16px * var(--user-scale));
	}

	/* --- BACKEND THEME SYSTEM --- */
	html[data-theme="backend"] {
		--font-family: var(--be-font-mono);
		--bg-color: var(--be-bg);
		--text-color: var(--be-text);
		--text-muted: var(--be-text-muted);
		--surface-color: var(--be-surface);
		--border-color: var(--be-surface-border);
		--accent-color: var(--be-primary);
		--secondary-color: var(--be-secondary);
		--glow-intensity: 0.5;
	}



	/* --- SYSTEMS THEME SYSTEM --- */
	html[data-theme="systems"] {
		--font-family: var(--sys-font-sans);
		--bg-color: var(--sys-bg);
		--text-color: var(--sys-text);
		--text-muted: var(--sys-text-muted);
		--surface-color: var(--sys-surface);
		--border-color: var(--sys-surface-border);
		--accent-color: var(--sys-primary);
		--secondary-color: var(--sys-secondary);
		--glow-intensity: 0.8;
	}

	/* -------------------------------------------------------------
	   GLOBAL STYLES & RESET
	   ------------------------------------------------------------- */
	*, *::before, *::after {
		box-sizing: border-box;
	}

	html, body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		font-family: var(--font-family);
		background-color: var(--bg-color);
		color: var(--text-color);
		transition: background-color 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
		            color 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
		            font-family 0.6s cubic-bezier(0.16, 1, 0.3, 1);
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		scroll-behavior: smooth;
	}

	/* Modern Custom Scrollbar */
	::-webkit-scrollbar {
		width: 10px;
		height: 10px;
	}
	::-webkit-scrollbar-track {
		background: var(--bg-color);
		transition: background 0.6s ease;
	}
	::-webkit-scrollbar-thumb {
		background: var(--border-color);
		border-radius: 5px;
		border: 2px solid var(--bg-color);
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--accent-color);
	}

	/* Typography & Accents */
	h1, h2, h3, h4, h5, h6 {
		margin: 0;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	p {
		line-height: 1.6;
		margin: 0;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Utility Animations */
	@keyframes pulseGlow {
		0%, 100% { opacity: 0.8; }
		50% { opacity: 1; filter: drop-shadow(0 0 15px var(--accent-color)); }
	}

	/* Dynamic glassmorphic gradient overlay in Frontend mode */
	body::before {
		content: "";
		position: fixed;
		top: -30%;
		left: -30%;
		width: 160%;
		height: 160%;
		background: radial-gradient(circle at 75% 20%, rgba(112, 0, 255, 0.15) 0%, transparent 40%),
		            radial-gradient(circle at 15% 80%, rgba(255, 0, 122, 0.12) 0%, transparent 40%);
		pointer-events: none;
		z-index: -1;
		transition: opacity 0.8s ease;
		opacity: 1;
	}

	html[data-theme="backend"] body::before {
		background: radial-gradient(circle at 50% -20%, rgba(0, 245, 160, 0.05) 0%, transparent 60%);
		opacity: 0.7;
	}

	/* Global Responsive Overrides for Mobile Viewports */
	@media (max-width: 600px) {
		.backend-lens-root,
		.frontend-lens-root {
			padding: 6rem 1.25rem 3rem !important;
		}
	}
</style>
