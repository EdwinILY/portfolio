---
// Backend Lens Astro Component
---

<div class="backend-lens-root">
  <!-- Centered Interactive Terminal Simulator -->
  <section class="terminal-section">
    <!-- Animated Matrix Digital Rain Canvas Background -->
    <canvas id="terminal-matrix-canvas" class="matrix-canvas"></canvas>

    <div class="terminal-window crt-active" id="terminal-window">
      <!-- CRT Overlay scanlines (Active by default) -->
      <div class="crt-overlay"></div>
      <div class="crt-screen-glow"></div>

      <div class="terminal-header">
        <div class="terminal-buttons">
          <span class="term-dot close"></span>
          <span class="term-dot minimize"></span>
          <span class="term-dot expand"></span>
        </div>
        <div class="terminal-title" id="terminal-title-bar">guest@ily-systems:~</div>
      </div>
      
      <div class="terminal-body" id="term-body">
        <div class="term-outputs" id="term-outputs">
          <!-- Terminal greeting or login prompt printed dynamically -->
        </div>
        <form class="term-input-line" id="term-form">
          <span class="term-prompt" id="term-prompt-label">Login como:</span>
          <input type="text" id="term-input" autocomplete="off" autofocus class="term-input" placeholder="Escribe tu nombre y presiona Enter..." />
        </form>
      </div>
    </div>

    <!-- Quick Shortcuts / Command Chips (Faded in post-login) -->
    <div class="terminal-quick-chips" id="quick-chips-container">
      <span class="chips-label">Comandos Rápidos:</span>
      <button class="chip-btn" data-cmd="neofetch">neofetch</button>
      <button class="chip-btn" data-cmd="ls">ls</button>
      <button class="chip-btn" data-cmd="cat README.md">cat README.md</button>
      <button class="chip-btn" data-cmd="cd skills && ls">cd skills & ls</button>
      <button class="chip-btn" data-cmd="help">help</button>
    </div>
  </section>
</div>

<style>
  /* -------------------------------------------------------------
     BACKEND PERSPECTIVE BASE - FULLY CENTERED
     ------------------------------------------------------------- */
  .backend-lens-root {
    padding: 7rem 2rem 5rem;
    max-width: 1200px;
    margin: 0 auto;
    min-height: calc(100vh - 100px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
  }

  /* -------------------------------------------------------------
     TERMINAL STYLES (EPIC SIZE, CENTERED & PREMIUM)
     ------------------------------------------------------------- */
  .terminal-section {
    width: 100%;
    max-width: 1100px;
    position: relative;
    z-index: 10; /* Sits securely on top of the fixed background canvas */
  }

  .matrix-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1; /* Sits on top of body bg, but behind everything else */
    pointer-events: none;
    opacity: 0.45; /* Increased opacity for clear contrast visibility */
    filter: blur(0.5px);
  }

  .terminal-window {
    background: #06090F;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), 0 0 40px rgba(0, 245, 160, 0.03);
    display: flex;
    flex-direction: column;
    height: 750px;
    position: relative;
    z-index: 11; /* Sits securely inside the terminal-section stack */
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .terminal-window:hover {
    border-color: rgba(0, 245, 160, 0.3);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.75), 0 0 50px rgba(0, 245, 160, 0.06);
  }

  .terminal-header {
    background: #0C1017;
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    font-size: 0.8rem;
    z-index: 11;
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
  }

  .terminal-buttons {
    display: flex;
    gap: 8px;
  }

  .term-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }

  .term-dot.close { background: #FF5F56; }
  .term-dot.minimize { background: #FFBD2E; }
  .term-dot.expand { background: #27C93F; }

  .terminal-title {
    color: var(--text-muted);
    font-weight: 500;
  }

  .terminal-body {
    padding: 1.75rem;
    flex: 1;
    overflow-y: auto;
    font-size: 0.95rem;
    display: flex;
    flex-direction: column;
    line-height: 1.45;
    background: #06090F;
    position: relative;
    z-index: 2;
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
  }

  .term-line {
    color: var(--text-color);
    margin-bottom: 0.5rem;
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
  }

  .term-line.welcome {
    color: var(--accent-color);
    font-weight: 700;
    font-size: 1.15rem;
    text-shadow: 0 0 10px rgba(0, 245, 160, 0.25);
  }

  .term-line.welcome-sub {
    color: var(--text-muted);
  }

  .hl-term {
    color: var(--secondary-color);
    text-decoration: underline;
  }

  .term-input-line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.03);
  }

  .term-prompt {
    color: var(--secondary-color);
    font-weight: bold;
    white-space: nowrap;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.2);
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
  }

  .term-input {
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
    font-size: 0.95rem;
    flex: 1;
    caret-color: var(--accent-color);
  }

  .term-input:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  /* -------------------------------------------------------------
     TERMINAL RICH OUTPUT STYLING - MONOSPACE GRID COHERENCE
     ------------------------------------------------------------- */
  .term-out-cmd {
    color: var(--secondary-color);
    margin-bottom: 0.4rem;
    font-weight: 500;
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
  }
  
  /* Reset browser pre-formatted text defaults to secure absolute grid styling */
  pre.term-out-response {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text-color);
    white-space: pre !important; /* Force native pre-formatting to secure tables/ascii column-alignment */
    overflow-x: auto; /* Allow horizontal scrolling if lines exceed container on tiny viewports */
    margin-bottom: 1.5rem;
    opacity: 0.95;
    line-height: 1.45;
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
  }

  .term-error {
    color: #FF5F56;
    font-weight: bold;
  }

  /* VFS clickable links */
  .term-dir, .term-file {
    cursor: pointer;
    font-weight: bold;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    transition: all 0.15s ease;
    display: inline-block;
  }

  .term-dir {
    color: var(--accent-color);
  }

  .term-dir:hover {
    background: rgba(0, 245, 160, 0.15);
    text-shadow: 0 0 10px rgba(0, 245, 160, 0.4);
  }

  .term-file.file-md {
    color: var(--secondary-color);
  }

  .term-file.file-md:hover {
    background: rgba(0, 229, 255, 0.15);
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
  }

  .term-file.file-json {
    color: var(--accent-color);
    filter: hue-rotate(45deg);
  }

  .term-file.file-json:hover {
    background: rgba(255, 184, 108, 0.15);
  }

  .term-file.file-pub {
    color: #FFB86C;
  }

  .term-file.file-pub:hover {
    background: rgba(255, 184, 108, 0.2);
  }

  /* JSON syntax colorizer classes */
  .json-key { color: #FF79C6; font-weight: bold; }
  .json-string { color: var(--accent-color); }
  .json-number { color: var(--secondary-color); }
  .json-boolean { color: #BD93F9; }
  .json-null { color: #6272A4; font-style: italic; }

  /* Markdown custom terminal tags */
  .md-h1 {
    display: block;
    color: var(--accent-color);
    font-size: 1.3rem;
    font-weight: bold;
    margin: 1rem 0 0.5rem;
    border-bottom: 1px solid rgba(0, 245, 160, 0.2);
    padding-bottom: 0.25rem;
  }

  .md-h2 {
    display: block;
    color: var(--secondary-color);
    font-size: 1.15rem;
    font-weight: bold;
    margin: 0.75rem 0 0.4rem;
  }

  .md-block-header {
    display: block;
    color: #FFFFFF;
    font-weight: bold;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.5rem;
    margin-top: 0.5rem;
    border-left: 3px solid var(--accent-color);
  }

  .md-bullet {
    color: var(--secondary-color);
    font-weight: bold;
    margin-right: 0.5rem;
  }

  .md-inline-code {
    background: rgba(255, 255, 255, 0.08);
    color: #FFB86C;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  /* -------------------------------------------------------------
     CRT OVERLAYS (CRT retro effects)
     ------------------------------------------------------------- */
  .crt-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
    background-size: 100% 3px, 3px 100%;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 9;
  }

  .crt-screen-glow {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 30%, rgba(0, 245, 160, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 8;
  }

  .terminal-window::after {
    content: " ";
    display: block;
    position: absolute;
    top: 0; left: 0; bottom: 0; right: 0;
    background: radial-gradient(circle, rgba(18, 16, 16, 0) 60%, rgba(0, 0, 0, 0.35) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 10;
    pointer-events: none;
  }

  .crt-active.terminal-window::after {
    opacity: 1;
  }

  .crt-active .crt-overlay {
    opacity: 0.85;
    animation: flicker 0.15s infinite;
  }

  .crt-active .crt-screen-glow {
    opacity: 1;
  }

  .crt-active .terminal-body {
    text-shadow: 0 0 4px rgba(0, 245, 160, 0.5);
  }

  @keyframes flicker {
    0% { opacity: 0.82; }
    50% { opacity: 0.88; }
    100% { opacity: 0.83; }
  }

  /* -------------------------------------------------------------
     TERMINAL QUICK CHIPS STYLE
     ------------------------------------------------------------- */
  .terminal-quick-chips {
    display: none; /* Hidden by default until logged in */
    opacity: 0;
    transform: translateY(10px);
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 1.5rem;
    padding: 0 0.5rem;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .terminal-quick-chips.show {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .chips-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: bold;
    margin-right: 0.25rem;
  }

  .chip-btn {
    background: #0B0E14;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    font-family: 'JetBrains Mono', 'Courier New', Courier, monospace !important;
    font-size: 0.8rem;
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chip-btn:hover {
    border-color: var(--accent-color);
    background: rgba(0, 245, 160, 0.05);
    color: var(--accent-color);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 245, 160, 0.1);
  }

  .chip-btn:active {
    transform: translateY(0);
  }

  /* Responsive Adjustments & Font Scaling for viewport matching */
  @media (max-width: 992px) {
    .terminal-window {
      height: 650px;
    }
  }

  @media (max-width: 768px) {
    .terminal-window {
      height: 550px;
    }
    .terminal-body {
      font-size: 0.78rem;
      padding: 1.25rem;
    }
    .term-input {
      font-size: 0.78rem;
    }
    .terminal-quick-chips {
      gap: 0.5rem;
    }
    .chip-btn {
      font-size: 0.75rem;
      padding: 0.35rem 0.7rem;
    }
  }

  @media (max-width: 576px) {
    .terminal-body {
      font-size: 0.65rem;
      padding: 1rem;
    }
    .term-input {
      font-size: 0.65rem;
    }
    pre.term-out-response {
      line-height: 1.35;
    }
  }
</style>

<script is:inline>
  // ---------------------------------------------------------------------------
  // VIRTUAL FILE SYSTEM DATA STRUCTURE IN SPANISH (VFS)
  // ---------------------------------------------------------------------------
  const VFS = {
    '/': {
      type: 'dir',
      children: {
        'README.md': {
          type: 'file',
          content: `===================================================================
■      EDWIN ILY — INGENIERO DE CORE & SISTEMAS                   ■
===================================================================

¡Bienvenido! Esta es una terminal interactiva que simula mi
entorno de desarrollo backend principal. 

Siéntete libre de navegar por archivos y directorios. Puedes escribir 
comandos de forma manual, presionar Tab para autocompletar, o hacer clic 
directamente en las carpetas y archivos listados en la respuesta para 
ejecutarlos al instante.

Escribe "help" para ver los comandos de ayuda de la shell, o empieza con:
  ls                  - Listar contenidos del directorio actual
  cd [directorio]      - Cambiar de directorio virtual activo
  cat [archivo]       - Ver el contenido de un archivo
