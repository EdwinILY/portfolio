  // ---------------------------------------------------------------------------
  // STATE & NEOFETCH ANIMATED HACKER SKULL FRAMES
  // ---------------------------------------------------------------------------
  let sessionUser = '';
  let currentDirArray = [];
  let commandHistory = [];
  let historyIndex = -1;
  let typingInterval = null;
  
  // Cyber Skeletal Skull (Joan G. Stark ASCII art)
  const skullFrames = [
    // Frame 0: Mouth Closed (Escaped backslashes properly for JS execution)
    [
      `                        <span style="color:var(--accent-color)">______</span>`,
      `                    <span style="color:var(--accent-color)">.-"      "-.</span>`,
      `                   <span style="color:var(--accent-color)">/            \\</span>`,
      `       _          <span style="color:var(--accent-color)">|              |</span>          _`,
      `      ( \\         |,  <span style="color:var(--secondary-color)">.-.</span>  <span style="color:var(--secondary-color)">.-.</span>  ,|         / )`,
      `       > "=._     | )<span style="color:var(--secondary-color)">(__/  \\__)</span>( |     _.=" <`,
      `      (_/"=._"=._ |/     <span style="color:var(--accent-color)">/\\</span>     \\| _.="_.="\\_)`,
      `             "=._ (_     <span style="color:var(--accent-color)">^^</span>     _)"_.="`,
      `                 "=\\__|<span style="color:var(--secondary-color)">IIIIII</span>|__/="`,
      `                _.="| \\<span style="color:var(--secondary-color)">IIIIII</span>/ |"=._`,
      `      _     _.="_.="\\          /"=._"=._     _`,
      `     ( \\_.="_.="     \`--------\`     "=._"=._/ )`,
      `      > _.="                            "=._ <`,
      `     (_/                                    \\_)`
    ],
    // Frame 1: Mouth Open
    [
      `                        <span style="color:var(--accent-color)">______</span>`,
      `                    <span style="color:var(--accent-color)">.-"      "-.</span>`,
      `                   <span style="color:var(--accent-color)">/            \\</span>`,
      `       _          <span style="color:var(--accent-color)">|              |</span>          _`,
      `      ( \\         |,  <span style="color:var(--secondary-color)">.-.</span>  <span style="color:var(--secondary-color)">.-.</span>  ,|         / )`,
      `       > "=._     | )<span style="color:var(--secondary-color)">(__/  \\__)</span>( |     _.=" <`,
      `      (_/"=._"=._ |/     <span style="color:var(--accent-color)">/\\</span>     \\| _.="_.="\\_)`,
      `             "=._ (_     <span style="color:var(--accent-color)">^^</span>     _)"_.="`,
      `                 "=\\__|<span style="color:var(--secondary-color)">IIIIII</span>|__/="`,
      `                _.="|  \\    /  |"=._`,
      `      _     _.="_.="  \\<span style="color:var(--secondary-color)">IIIIII</span>/  "=._"=._     _`,
      `     ( \\_.="_.="    \\          /    "=._"=._/ )`,
      `      > _.="         \`--------\`         "=._ <`,
      `     (_/                                    \\_)`
    ]
  ];

  // ---------------------------------------------------------------------------
  // BACKGROUND MATRIX CANVAS ENGINE (High-fidelity ambient animation)
  // ---------------------------------------------------------------------------
  const matrixCanvas = document.getElementById('terminal-matrix-canvas');
  if (matrixCanvas) {
    const ctx = matrixCanvas.getContext('2d');
    if (ctx) {
      let width = 0;
      let height = 0;
      let yPositions = [];
      
      // Dynamically calculate and adjust canvas dimensions when it becomes visible!
      function resizeCanvas() {
        if (!matrixCanvas) return;
        const w = window.innerWidth;
        const h = window.innerHeight;
        if (matrixCanvas.width !== w || matrixCanvas.height !== h) {
          width = matrixCanvas.width = w;
          height = matrixCanvas.height = h;
          
          // Re-initialize code stream columns securely using a standard for loop
          yPositions = [];
          const columns = Math.floor(width / 24) + 1;
          for (let i = 0; i < columns; i++) {
            // Scatter drops both on-screen and off-screen so animation starts instantly populated
            yPositions.push((Math.random() * 2 - 1) * height);
          }
        }
      }
      
      function drawMatrix() {
        if (width === 0 || height === 0) return;
        
        // Transparent overlay to create fading stream trails
        ctx.fillStyle = 'rgba(6, 9, 15, 0.08)'; // matches #06090F terminal bg
        ctx.fillRect(0, 0, width, height);
        
        ctx.font = '12px "JetBrains Mono", monospace';
        
        for (let i = 0; i < yPositions.length; i++) {
          const y = yPositions[i];
          const chars = ['0', '1', '<', '>', '/', ';', '{', '}', '[', ']', 'go', 'db', 'io', 'nil', 'err', 'req'];
          const text = chars[Math.floor(Math.random() * chars.length)];
          const x = i * 24;
          
          // Brighter opacity for excellent visual contrast
          const opacity = Math.random() * 0.4 + 0.15;
          const isCyan = Math.random() > 0.75;
          ctx.fillStyle = isCyan ? `rgba(0, 229, 255, ${opacity})` : `rgba(0, 245, 160, ${opacity})`;
          
          ctx.fillText(text, x, y);
          
          if (y > height && Math.random() > 0.975) {
            yPositions[i] = 0;
          } else {
            yPositions[i] = y + 16;
          }
        }
      }
      
      function animateMatrix() {
        // Safe check if canvas is currently visible in the DOM
        const rect = matrixCanvas.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          resizeCanvas();
          drawMatrix();
        }
        requestAnimationFrame(animateMatrix);
      }
      
      requestAnimationFrame(animateMatrix);
    }
  }

  // DOM elements cache
  const termWindow = document.getElementById('terminal-window');
  const termForm = document.getElementById('term-form');
  const termInput = document.getElementById('term-input');
  const termOutputs = document.getElementById('term-outputs');
  const termBody = document.getElementById('term-body');
  const promptLabel = document.getElementById('term-prompt-label');
  const titleBar = document.getElementById('terminal-title-bar');
  const crtBtn = document.getElementById('crt-toggle-btn');
  const chips = document.querySelectorAll('.chip-btn');
  const chipsContainer = document.getElementById('quick-chips-container');

  // Initial greeting and username request in Spanish
  window.addEventListener('load', () => {
    if (termInput) {
      termInput.focus();
      
      const loginLog = document.createElement('pre');
      loginLog.className = 'term-out-response';
      loginLog.innerHTML = `<span class="term-line welcome">=== PASARELA DE SEGURIDAD DE EDWIN ILY ===</span>
<span style="color: var(--text-muted)">Estableciendo conexión con el núcleo del servidor (10.0.0.42)... ÉXITO.</span>
Por favor ingresa tu nombre para iniciar una sesión segura personalizada:`;
      termOutputs.appendChild(loginLog);
    }
  });

  // Let click anywhere in body focus the input
  if (termBody) {
    termBody.addEventListener('click', (e) => {
      if (window.getSelection().toString() === '' && !e.target.classList.contains('term-dir') && !e.target.classList.contains('term-file')) {
        termInput.focus();
      }
    });
  }

  // ---------------------------------------------------------------------------
  // VFS PATH RESOLUTION HELPERS
  // ---------------------------------------------------------------------------
  function getCurrentNode() {
    let node = VFS['/'];
    for (const part of currentDirArray) {
      if (node.children && node.children[part]) {
        node = node.children[part];
      }
    }
    return node;
  }

  function resolvePath(targetPath) {
    if (!targetPath || targetPath === '/') {
      return { node: VFS['/'], path: '/', parts: [] };
    }

    let parts = [];
    if (targetPath.startsWith('/')) {
      parts = targetPath.split('/').filter(p => p !== '');
    } else {
      parts = [...currentDirArray];
      const relParts = targetPath.split('/').filter(p => p !== '');
      for (const part of relParts) {
        if (part === '.') {
          continue;
        } else if (part === '..') {
          if (parts.length > 0) parts.pop();
        } else {
          parts.push(part);
        }
      }
    }

    // Verify VFS existence
    let node = VFS['/'];
    for (const part of parts) {
      if (node.children && node.children[part]) {
        node = node.children[part];
      } else {
        return { node: null, path: null, parts: null };
      }
    }

    return { node, path: '/' + parts.join('/'), parts };
  }

  function updatePromptLabel() {
    if (!promptLabel) return;
    if (!sessionUser) {
      promptLabel.innerText = 'Login como:';
      return;
    }
    const pathStr = currentDirArray.length > 0 ? '/' + currentDirArray.join('/') : '~';
    promptLabel.innerText = `${sessionUser}@ily-systems:${pathStr}$`;
  }

  // ---------------------------------------------------------------------------
  // FORMATTERS (JSON COLORIZER & MARKDOWN)
  // ---------------------------------------------------------------------------
  function colorizeJSON(jsonStr) {
    try {
      const parsed = JSON.parse(jsonStr);
      const pretty = JSON.stringify(parsed, null, 2);
      return pretty.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+-]?\d+)?)/g, function (match) {
        let cls = 'json-number';
        if (/^"/.test(match)) {
          if (/:$/.test(match)) {
            cls = 'json-key';
          } else {
            cls = 'json-string';
          }
        } else if (/true|false/.test(match)) {
          cls = 'json-boolean';
        } else if (/null/.test(match)) {
          cls = 'json-null';
        }
        return `<span class="${cls}">${match}</span>`;
      });
    } catch (e) {
      return jsonStr;
    }
  }

  function formatMarkdown(mdStr) {
    let lines = mdStr.split('\n');
    return lines.map(line => {
      if (line.startsWith('# ')) {
        return `<span class="md-h1">${line.substring(2)}</span>`;
      }
      if (line.startsWith('## ')) {
        return `<span class="md-h2">${line.substring(3)}</span>`;
      }
      if (line.startsWith('### ')) {
        return `<span class="md-h3">${line.substring(4)}</span>`;
      }
      if (line.startsWith('■ ')) {
        return `<span class="md-block-header">${line}</span>`;
      }
      if (line.trim().startsWith('- ')) {
        const indent = line.substring(0, line.indexOf('-'));
        return `${indent}<span class="md-bullet">•</span> ${line.trim().substring(2)}`;
      }
      if (line.includes('`')) {
        line = line.replace(/`([^`]+)`/g, '<span class="md-inline-code">$1</span>');
      }
      return line;
    }).join('\n');
  }

  // ---------------------------------------------------------------------------
  // NEOFETCH SIDE-BY-SIDE INTEGRITY RENDERER
  // ---------------------------------------------------------------------------
  function getPlainTextLength(htmlStr) {
    const plain = htmlStr.replace(/<[^>]*>/g, '');
    return plain.length;
  }

  function getNeofetchText(frameIndex, uptimeDays, ramUsage) {
    const user = sessionUser || 'guest';
    const skull = skullFrames[frameIndex];
    const info = [
      `<span style="color:var(--accent-color); font-weight:bold">${user}@ily-systems</span>`,
      `-----------------`,
      `<span style="color:var(--secondary-color)">OS:</span> EdwinOS v3.0.0 (Astro 6 Core)`,
      `<span style="color:var(--secondary-color)">Núcleo:</span> Micro-programador de Go-rutinas`,
      `<span style="color:var(--secondary-color)">Tiempo activo:</span> ${uptimeDays} días, 4 horas, 12 mins`,
      `<span style="color:var(--secondary-color)">Shell:</span> Edwin-Sistemas-Interactive-Bash v3.0`,
      `<span style="color:var(--secondary-color)">Procesador:</span> Intel Core i9-Concurrencia (24 Núcleos)`,
      `<span style="color:var(--secondary-color)">Memoria:</span> ${ramUsage}MB / 1024MB (Caché Redis Buffer)`,
      `<span style="color:var(--secondary-color)">BD Principal:</span> PostgreSQL 16 (Normalizado, PgBouncer)`,
      `<span style="color:var(--secondary-color)">Telemetría:</span> Conexión de gateway activa y segura`
    ];

    if (window.innerWidth < 768) {
      // Stack vertically on mobile viewports for perfect mobile responsiveness
      return `${skull.join('\n')}\n\n${info.join('\n')}`;
    }

    let lines = [];
    const maxLines = Math.max(skull.length, info.length);
    for (let i = 0; i < maxLines; i++) {
      const skullLine = skull[i] || '';
      const infoLine = info[i] || '';
      
      // Calculate plain text width of skull line and pad to 54 characters for skull clearance
      const plainLen = getPlainTextLength(skullLine);
      const paddingSpaces = ' '.repeat(Math.max(0, 54 - plainLen));
      
      lines.push(`${skullLine}${paddingSpaces}${infoLine}`);
    }
    return lines.join('\n');
  }

  // ---------------------------------------------------------------------------
  // SHELL COMMAND EVALUATORS IN SPANISH
  // ---------------------------------------------------------------------------
  function runHelp() {
    return `Comandos de shell disponibles:
  help                     - Mostrar este listado de ayuda.
  ls                       - Listar contenidos del directorio virtual actual.
  cd [dir]                 - Cambiar el directorio virtual activo.
  cat [archivo]            - Leer el contenido de un archivo con sintaxis resaltada.
  pwd                      - Imprimir la ruta absoluta del directorio de trabajo.
  neofetch                 - Mostrar telemetría y diagnósticos estéticos del sistema.
  clear                    - Limpiar el historial de la pantalla de terminal.
  
💡 Consejo: ¡Puedes hacer clic en las carpetas y archivos en la respuesta para explorarlos!`;
  }

  function runLs() {
    const node = getCurrentNode();
    if (!node.children || Object.keys(node.children).length === 0) {
      return `<span style="color:var(--text-muted)">[Directorio Vacío]</span>`;
    }

    const items = Object.entries(node.children).map(([name, child]) => {
      if (child.type === 'dir') {
        return `<span class="term-dir dir-link" data-path="${name}">${name}/</span>`;
      } else {
        let cls = 'term-file file-link';
        if (name.endsWith('.md')) cls += ' file-md';
        else if (name.endsWith('.json')) cls += ' file-json';
        else if (name.endsWith('.pub')) cls += ' file-pub';
        return `<span class="${cls}" data-file="${name}">${name}</span>`;
      }
    });

    return items.join('    ');
  }

  function runCd(args) {
    const target = args[0] || '/';
    const { node, path, parts } = resolvePath(target);

    if (!node) {
      return `<span class="term-error">cd: no existe el archivo o directorio: ${target}</span>`;
    }
    if (node.type !== 'dir') {
      return `<span class="term-error">cd: no es un directorio: ${target}</span>`;
    }

    currentDirArray = parts;
    updatePromptLabel();
    return '';
  }

  function runCat(args) {
    if (!args[0]) {
      return `<span class="term-error">cat: falta el operando de archivo. Uso: cat [nombre_archivo]</span>`;
    }

    const target = args[0];
    const { node } = resolvePath(target);

    if (!node) {
      return `<span class="term-error">cat: ${target}: No existe el archivo o directorio</span>`;
    }
    if (node.type === 'dir') {
      return `<span class="term-error">cat: ${target}: Es un directorio</span>`;
    }

    if (target.endsWith('.json')) {
      return colorizeJSON(node.content);
    } else if (target.endsWith('.md')) {
      return formatMarkdown(node.content);
    } else {
      return node.content;
    }
  }

  // ---------------------------------------------------------------------------
  // ACTIVE ANIMATED NEOFETCH ENGINE REGISTRATION
  // ---------------------------------------------------------------------------
  let neofetchFrame = 0;
  let neofetchUptime = Math.floor(Math.random() * 15) + 30;
  let neofetchRam = Math.floor(Math.random() * 20) + 130;

  // Global mouth animator interval loop (400ms speed)
  setInterval(() => {
    neofetchFrame = (neofetchFrame + 1) % 2;
    const activeBlocks = document.querySelectorAll('.neofetch-anim-block');
    activeBlocks.forEach(block => {
      block.innerHTML = getNeofetchText(neofetchFrame, neofetchUptime, neofetchRam);
    });
  }, 400);

  function runNeofetch() {
    return `<span class="neofetch-anim-block">${getNeofetchText(neofetchFrame, neofetchUptime, neofetchRam)}</span>`;
  }

  // ---------------------------------------------------------------------------
  // MAIN COMMAND EXECUTION ENGINE
  // ---------------------------------------------------------------------------
  function executeCommand(cmdStr) {
    const cleanCmd = cmdStr.trim();
    if (!cleanCmd) return;

    // Put command on terminal history line
    const cmdLine = document.createElement('div');
    cmdLine.className = 'term-out-cmd';
    const pathStr = currentDirArray.length > 0 ? '/' + currentDirArray.join('/') : '~';
    const user = sessionUser || 'guest';
    cmdLine.innerHTML = `<span class="term-prompt">${user}@ily-systems:${pathStr}$</span> ${cleanCmd}`;
    termOutputs.appendChild(cmdLine);

    // Evaluate
    const parts = cleanCmd.split(/\s+/);
    const mainCmd = parts[0].toLowerCase();
    const args = parts.slice(1);

    let outputHTML = '';
    if (mainCmd === 'help') {
      outputHTML = runHelp();
    } else if (mainCmd === 'clear') {
      termOutputs.innerHTML = '';
      return;
    } else if (mainCmd === 'ls') {
      outputHTML = runLs();
    } else if (mainCmd === 'cd') {
      outputHTML = runCd(args);
    } else if (mainCmd === 'cat') {
      outputHTML = runCat(args);
    } else if (mainCmd === 'pwd') {
      outputHTML = '/' + currentDirArray.join('/');
    } else if (mainCmd === 'neofetch') {
      outputHTML = runNeofetch();
    } else {
      outputHTML = `<span class="term-error">Error de shell: Comando no encontrado: "${mainCmd}". Escribe "help" para ver opciones.</span>`;
    }

    // Print responses (Strict native PRE block)
    if (outputHTML !== '') {
      const respLine = document.createElement('pre');
      respLine.className = 'term-out-response';
      respLine.innerHTML = outputHTML;
      termOutputs.appendChild(respLine);
    }

    termBody.scrollTop = termBody.scrollHeight;
  }

  // ---------------------------------------------------------------------------
  // LISTENERS AND MICRO-INTERACTIONS
  // ---------------------------------------------------------------------------
  if (termForm) {
    termForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = termInput.value;
      termInput.value = '';

      if (!val.trim()) return;

      // --- USER LOGIN FLOW (WITH COOL MOCK DIANOSTIC AUTH LOGS & AUTO-CLEAR) ---
      if (!sessionUser) {
        const username = val.trim().replace(/\s+/g, '_');
        termInput.disabled = true;

        // Show the typed username
        const inputLine = document.createElement('div');
        inputLine.className = 'term-out-cmd';
        inputLine.innerHTML = `<span class="term-prompt">Login como:</span> ${username}`;
        termOutputs.appendChild(inputLine);

        // Cool rapid logging sequences in Spanish
        const logSteps = [
          { delay: 150, text: '<span style="color:var(--text-muted)">[ SISTEMA ]</span> Conectando al gateway de autenticación auth-gateway.internal.ily-systems (10.0.0.42)... ÉXITO.' },
          { delay: 400, text: '<span style="color:var(--text-muted)">[ SISTEMA ]</span> Solicitando apretón de manos criptográfico... intercambiando parámetros DH.' },
          { delay: 650, text: '<span style="color:var(--text-muted)">[ AUTH ]</span> Buscando registros de credenciales para el nodo de usuario: <span style="color:var(--accent-color)">' + username + '</span>' },
          { delay: 950, text: '<span style="color:var(--text-muted)">[ AUTH ]</span> Payload coincidente. Checksum de validación SHA-256: <span style="color:var(--accent-color)">OK</span>' },
          { delay: 1200, text: '<span style="color:var(--text-muted)">[ SISTEMA ]</span> Asegurando tokens de sesión... socket establecido (tty/1).' },
          { delay: 1450, text: '<span style="color:var(--text-muted)">[ SISTEMA ]</span> Preparando asignaciones de entorno, montando binarios locales... /bin cargado.' },
          { delay: 1700, text: '<span style="color:var(--accent-color); font-weight:bold">[ ÉXITO ] ¡Conexión autorizada! Iniciando shell de terminal-TTY personalizada...</span>' }
        ];

        logSteps.forEach(step => {
          setTimeout(() => {
            const line = document.createElement('div');
            line.className = 'term-line';
            line.innerHTML = step.text;
            termOutputs.appendChild(line);
            termBody.scrollTop = termBody.scrollHeight;
          }, step.delay);
        });

        // Clear and render welcome session in Spanish
        setTimeout(() => {
          termOutputs.innerHTML = ''; // CLEAR THE TERMINAL ENTIRELY
          
          sessionUser = username;

          // Update UI header and prompt labels
          if (titleBar) titleBar.innerText = `${sessionUser}@ily-systems:~`;
          updatePromptLabel();
          
          termInput.disabled = false;
          termInput.placeholder = 'Escribe un comando (o presiona Tab para autocompletar)...';
          termInput.focus();

          // Render the custom connection header
          const now = new Date();
          const welcomeLine = document.createElement('pre');
          welcomeLine.className = 'term-out-response';
          welcomeLine.innerHTML = `<span class="term-line welcome">=== SESIÓN SEGURA ESTABLECIDA PARA ${sessionUser.toUpperCase()} ===</span>
<span style="color:var(--text-muted)">Terminal: tty/1 | Seguridad: activa | Hora Local: ${now.toLocaleTimeString()}</span>
¡Bienvenido de nuevo! Para comenzar, te sugiero escribir <span style="color:var(--accent-color); font-weight:bold">cat README.md</span> y presionar Enter.
Or usa los comandos rápidos de abajo para explorar mis sistemas.`;
          termOutputs.appendChild(welcomeLine);

          // Slide in the quick chips
          if (chipsContainer) {
            chipsContainer.classList.add('show');
          }

          // Trigger automatic command neofetch ONLY
          setTimeout(() => {
            executeCommand('neofetch');
          }, 400);

        }, 2100);

        return;
      }

      // --- NORMAL SHELL BEHAVIOR ---
      commandHistory.push(val);
      historyIndex = -1;
      executeCommand(val);
    });
  }

  // Up/down history support
  if (termInput) {
    termInput.addEventListener('keydown', (e) => {
      if (!sessionUser) return;

      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (commandHistory.length === 0) return;
        if (historyIndex === -1) historyIndex = commandHistory.length;
        
        if (historyIndex > 0) {
          historyIndex--;
          termInput.value = commandHistory[historyIndex];
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (commandHistory.length === 0) return;
        if (historyIndex !== -1 && historyIndex < commandHistory.length - 1) {
          historyIndex++;
          termInput.value = commandHistory[historyIndex];
        } else {
          historyIndex = -1;
          termInput.value = '';
        }
      } else if (e.key === 'Tab') {
        e.preventDefault();
        const val = termInput.value.trim();
        if (!val) return;
        
        const parts = val.split(/\s+/);
        if (parts.length > 2) return;
        
        const cmd = parts[0].toLowerCase();
        const arg = parts[1] || '';
        
        if (cmd === 'cat' || cmd === 'cd') {
          const node = getCurrentNode();
          if (!node.children) return;
          
          const matches = Object.keys(node.children).filter(name => {
            const child = node.children[name];
            if (cmd === 'cd' && child.type !== 'dir') return false;
            return name.toLowerCase().startsWith(arg.toLowerCase());
          });
          
          if (matches.length === 1) {
            termInput.value = `${cmd} ${matches[0]}`;
          } else if (matches.length > 1) {
            const matchLine = document.createElement('pre');
            matchLine.className = 'term-out-response';
            matchLine.innerText = matches.join('   ');
            termOutputs.appendChild(matchLine);
            termBody.scrollTop = termBody.scrollHeight;
          }
        }
      }
    });
  }

  // Click handler delegation for printed file/dir links
  if (termOutputs) {
    termOutputs.addEventListener('click', (e) => {
      if (!sessionUser) return;
      
      if (e.target.classList.contains('dir-link')) {
        const path = e.target.getAttribute('data-path');
        executeCommand(`cd ${path}`);
        executeCommand('ls');
      } else if (e.target.classList.contains('file-link')) {
        const file = e.target.getAttribute('data-file');
        executeCommand(`cat ${file}`);
      }
    });
  }

  // Typist simulator for quick chips click
  function simulateTyping(cmdStr, callback) {
    if (typingInterval) clearInterval(typingInterval);
    
    termInput.value = '';
    termInput.disabled = true;
    
    let i = 0;
    typingInterval = setInterval(() => {
      if (i < cmdStr.length) {
        termInput.value += cmdStr.charAt(i);
        i++;
        termBody.scrollTop = termBody.scrollHeight;
      } else {
        clearInterval(typingInterval);
        termInput.disabled = false;
        termInput.focus();
        if (callback) callback();
      }
    }, 30);
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      if (!sessionUser) return;
      
      const cmd = chip.getAttribute('data-cmd');
      simulateTyping(cmd, () => {
        executeCommand(cmd);
        termInput.value = '';
      });
    });
  });
</script>
