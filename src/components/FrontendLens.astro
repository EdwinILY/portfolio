<script is:inline>
  // -------------------------------------------------------------
  // THREE.JS HOLOGRAPHIC CRYSTAL PRISM VIEWPORT
  // -------------------------------------------------------------
  let threeAnimationId = null;
  let activeRenderer = null; // Save reference to dispose of webgl context
  let audioCtx = null;
  let analyser = null;
  let audioStream = null;
  let dataArray = null;
  let isAudioSyncActive = false;
  window.audioSensitivity = 1.4; // Global sensitivity threshold

  // Real-time audio sync helpers
  async function startAudioSync(syncBtn) {
    try {
      audioStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 128; // Optimized for performance and 7 visualizer bars
      analyser.smoothingTimeConstant = 0.55; // Snappier, less laggy response to beats!
      
      const source = audioCtx.createMediaStreamSource(audioStream);
      source.connect(analyser);
      
      isAudioSyncActive = true;
      if (syncBtn) {
        syncBtn.classList.add('active');
        const syncText = syncBtn.querySelector('.sync-text');
        if (syncText) syncText.textContent = '🔊 Música Activa';
      }

      // Also dynamically update simulated widget details
      const trackTitle = document.querySelector('#preview-audio .track-title');
      const trackArtist = document.querySelector('#preview-audio .track-artist');
      const audioArt = document.querySelector('#preview-audio .audio-art');
      if (trackTitle) trackTitle.textContent = 'Mic / System Audio';
      if (trackArtist) trackArtist.textContent = 'Real-time Music Input';
      if (audioArt) audioArt.textContent = '🎤';
    } catch (err) {
      console.error("Error accessing microphone:", err);
      alert("Para sincronizar la música con el cristal 3D, activa el acceso al micrófono. Si quieres capturar el sonido del sistema directamente, puedes configurar Stereo Mix / Mezcla Estéreo como tu dispositivo de entrada predeterminado.");
      isAudioSyncActive = false;
      if (syncBtn) {
        syncBtn.classList.remove('active');
        const syncText = syncBtn.querySelector('.sync-text');
        if (syncText) syncText.textContent = '🎤 Sincronizar Música';
      }
    }
  }

  window.stopAudioSync = function() {
    isAudioSyncActive = false;
    if (audioStream) {
      audioStream.getTracks().forEach(track => track.stop());
      audioStream = null;
    }
    if (audioCtx) {
      audioCtx.close();
      audioCtx = null;
    }
    analyser = null;
    dataArray = null;

    const syncBtn = document.getElementById('three-audio-sync-btn');
    if (syncBtn) {
      syncBtn.classList.remove('active');
      const syncText = syncBtn.querySelector('.sync-text');
      if (syncText) syncText.textContent = '🎤 Sincronizar Música';
    }

    const visualizerBars = document.getElementById('visualizer-bars');
    if (visualizerBars) {
      visualizerBars.classList.remove('playing');
      const bars = visualizerBars.querySelectorAll('.bar');
      bars.forEach(bar => {
        bar.style.height = '';
        bar.style.animation = '';
      });
    }

    const trackTitle = document.querySelector('#preview-audio .track-title');
    const trackArtist = document.querySelector('#preview-audio .track-artist');
    const audioArt = document.querySelector('#preview-audio .audio-art');
    if (trackTitle) trackTitle.textContent = 'Creative Coding.mp3';
    if (trackArtist) trackArtist.textContent = 'Astro Beats Subsystem';
    if (audioArt) audioArt.textContent = '🎵';
  };

  function initThreePlayground() {
    if (threeAnimationId) {
      cancelAnimationFrame(threeAnimationId);
      threeAnimationId = null;
    }
    
    // Dispose of previous renderer to prevent WebGL context leaks
    if (activeRenderer) {
      try {
        activeRenderer.dispose();
      } catch (e) {
        console.error("Error disposing renderer:", e);
      }
      activeRenderer = null;
    }
    
    const canvas = document.getElementById('three-playground-canvas');
    if (!canvas || !window.THREE) return;
    
    const container = canvas.parentElement;
    const THREE = window.THREE;
    
    // Scene creation
    const scene = new THREE.Scene();
    
    // WebGL Renderer Setup (alpha transparency for seamless look)
    const renderer = new THREE.WebGLRenderer({
      canvas: canvas,
      alpha: true,
      antialias: true
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);
    activeRenderer = renderer; // Save reference
    
    // Camera Setup
    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.z = 5.2;
    
    // Lights Setup (Ambient + Dual colored point lights)
    const ambientLight = new THREE.AmbientLight(0x0a051d, 3.0);
    scene.add(ambientLight);
    
    const pointLight1 = new THREE.PointLight(0x8B5CF6, 4.0, 15); // Neon Purple
    pointLight1.position.set(2.5, 3.0, 2.0);
    scene.add(pointLight1);
    
    const pointLight2 = new THREE.PointLight(0x00E5FF, 3.0, 15); // Cyber Cyan
    pointLight2.position.set(-2.5, -3.0, 2.0);
    scene.add(pointLight2);
    
    // Geometries
    // Center faceted Crystal Prism (Octahedron has 8 flat glass faces - highly performant!)
    const crystalGeo = new THREE.OctahedronGeometry(1.2, 0);
    const crystalMat = new THREE.MeshPhongMaterial({
      color: 0x06030c,
      emissive: 0x110724,
      specular: 0x8B5CF6,
      shininess: 90,
      flatShading: true // Gives a stunning low-poly glass refraction look
    });
    const crystalMesh = new THREE.Mesh(crystalGeo, crystalMat);
    scene.add(crystalMesh);
    
    // Double orbital refraction rings (representing light rays)
    const ringGeo1 = new THREE.TorusGeometry(1.65, 0.012, 8, 48);
    const ringMat1 = new THREE.MeshBasicMaterial({
      color: 0x8B5CF6,
      transparent: true,
      opacity: 0.4
    });
    const ringMesh1 = new THREE.Mesh(ringGeo1, ringMat1);
    ringMesh1.rotation.x = Math.PI / 2.5;
    scene.add(ringMesh1);

    const ringGeo2 = new THREE.TorusGeometry(1.8, 0.01, 8, 48);
    const ringMat2 = new THREE.MeshBasicMaterial({
      color: 0x00E5FF,
      transparent: true,
      opacity: 0.3
    });
    const ringMesh2 = new THREE.Mesh(ringGeo2, ringMat2);
    ringMesh2.rotation.y = Math.PI / 3.0;
    scene.add(ringMesh2);

    // Subtle Particle Swarm
    const particleCount = 45;
    const pGeo = new THREE.BufferGeometry();
    const pPos = new Float32Array(particleCount * 3);
    const pData = [];

    for (let i = 0; i < particleCount; i++) {
      const angle = Math.random() * Math.PI * 2;
      const radius = 1.45 + Math.random() * 1.0;
      const speed = 0.2 + Math.random() * 0.4;
      const height = (Math.random() - 0.5) * 0.8;

      pPos[i * 3] = Math.cos(angle) * radius;
      pPos[i * 3 + 1] = height;
      pPos[i * 3 + 2] = Math.sin(angle) * radius;

      pData.push({ angle, radius, speed, height });
    }

    pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
    const pMat = new THREE.PointsMaterial({
      color: 0xC084FC,
      size: 0.05,
      transparent: true,
      opacity: 0.6
    });
    const particles = new THREE.Points(pGeo, pMat);
    scene.add(particles);
    
    // Parallax interaction variables
    let mouseX = 0, mouseY = 0;
    let targetX = 0, targetY = 0;
    
    container.addEventListener('mousemove', (e) => {
      const rect = container.getBoundingClientRect();
      targetX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      targetY = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    });
    
    container.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
    });
    
    // Responsive Resize Observer
    const resizeObserver = new ResizeObserver(() => {
      if (container.clientWidth === 0 || container.clientHeight === 0) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
    resizeObserver.observe(container);
    
    // Click action: Crystalline kinetic pulse
    let pulseScale = 1.0;
    let pulseVelocity = 0.0;
    
    container.addEventListener('click', () => {
      pulseScale = 1.45; // Expand core crystal
      pointLight1.intensity = 8.0; // Flash lighting
      pointLight2.intensity = 6.0;
      
      // Temporary ring spin speed increase
      ringMesh1.rotation.z += 1.5;
      ringMesh2.rotation.z -= 1.5;
    });

    // Setup Audio Sync Button Event
    const syncBtn = document.getElementById('three-audio-sync-btn');
    if (syncBtn) {
      if (isAudioSyncActive) {
        syncBtn.classList.add('active');
        const syncText = syncBtn.querySelector('.sync-text');
        if (syncText) syncText.textContent = '🔊 Música Activa';
      } else {
        syncBtn.classList.remove('active');
        const syncText = syncBtn.querySelector('.sync-text');
        if (syncText) syncText.textContent = '🎤 Sincronizar Música';
      }

      syncBtn.onclick = async (e) => {
        e.stopPropagation();
        if (isAudioSyncActive) {
          window.stopAudioSync();
        } else {
          await startAudioSync(syncBtn);
        }
      };
    }

    // Setup Sensitivity Threshold Slider
    const sensSlider = document.getElementById('audio-sensitivity-slider');
    const sensValLabel = document.getElementById('val-sensitivity');
    if (sensSlider) {
      sensSlider.value = window.audioSensitivity;
      if (sensValLabel) sensValLabel.textContent = `${window.audioSensitivity.toFixed(1)}x`;

      sensSlider.oninput = () => {
        const val = parseFloat(sensSlider.value);
        window.audioSensitivity = val;
        if (sensValLabel) sensValLabel.textContent = `${val.toFixed(1)}x`;
      };
    }
    
    const clock = new THREE.Clock();
    
    function animate() {
      // Clean exit if element is no longer attached or display:none is active
      if (!document.getElementById('three-playground-canvas') || canvas.offsetParent === null) {
        threeAnimationId = null;
        return;
      }
      
      const time = clock.getElapsedTime();

      // Real-time audio analysis values
      let audioIntensity = 0;
      let bassIntensity = 0;
      let trebleIntensity = 0;

      if (isAudioSyncActive && analyser) {
        const bufferLength = analyser.frequencyBinCount;
        if (!dataArray || dataArray.length !== bufferLength) {
          dataArray = new Uint8Array(bufferLength);
        }
        analyser.getByteFrequencyData(dataArray);

        let total = 0;
        let bass = 0;
        let treble = 0;
        const bassCount = Math.min(6, bufferLength);
        const trebleStart = Math.floor(bufferLength * 0.4);
        const trebleEnd = Math.floor(bufferLength * 0.8);

        for (let i = 0; i < bufferLength; i++) {
          total += dataArray[i];
          if (i < bassCount) {
            bass += dataArray[i];
          }
          if (i >= trebleStart && i <= trebleEnd) {
            treble += dataArray[i];
          }
        }

        const avg = total / bufferLength;
        const avgBass = bass / bassCount;
        const avgTreble = treble / (trebleEnd - trebleStart + 1);

        // Boost sensitivity dynamically set by the manual slider threshold
        const sensitivity = window.audioSensitivity; 
        audioIntensity = Math.min(1.0, (avg / 255.0) * sensitivity);
        bassIntensity = Math.min(1.0, (avgBass / 255.0) * sensitivity);
        trebleIntensity = Math.min(1.0, (avgTreble / 255.0) * sensitivity);

        // Update visualizer bars in Workbench preview
        const visualizerBars = document.getElementById('visualizer-bars');
        if (visualizerBars) {
          const bars = visualizerBars.querySelectorAll('.bar');
          if (bars.length > 0) {
            if (!visualizerBars.classList.contains('playing')) {
              visualizerBars.classList.add('playing');
            }
            const step = Math.floor(bufferLength / bars.length);
            for (let b = 0; b < bars.length; b++) {
              let bandSum = 0;
              const start = b * step;
              for (let j = start; j < start + step; j++) {
                bandSum += dataArray[j];
              }
              const stepAvg = bandSum / step;
              const barHeight = Math.max(3, Math.min(1.0, (stepAvg / 255.0) * sensitivity) * 22);
              bars[b].style.height = `${barHeight}px`;
              bars[b].style.animation = 'none';
            }
          }
        }
      }
      
      // Apply spring easing to click kinetic pulse
      const springTension = 0.15;
      const springFriction = 0.8;
      
      const springForce = (1.0 - pulseScale) * springTension;
      pulseVelocity += springForce;
      pulseVelocity *= springFriction;
      pulseScale += pulseVelocity;

      // Add real-time music pulse scale component
      const audioScaleBase = 1.0 + bassIntensity * 0.55;
      const finalCrystalScale = Math.max(pulseScale, audioScaleBase);
      
      // Interpolate light intensities nicely incorporating click + music beats
      const targetLight1 = 4.0 + bassIntensity * 12.0;
      const targetLight2 = 3.0 + trebleIntensity * 8.0;
      pointLight1.intensity += (targetLight1 - pointLight1.intensity) * 0.2;
      pointLight2.intensity += (targetLight2 - pointLight2.intensity) * 0.2;
      
      // Apply parallax coordinates
      mouseX += (targetX - mouseX) * 0.08;
      mouseY += (targetY - mouseY) * 0.08;
      
      // Crystal slow spinning + cursor focus tracking
      crystalMesh.rotation.y = time * 0.15 + mouseX * 0.4;
      crystalMesh.rotation.x = time * 0.1 + mouseY * 0.4;
      crystalMesh.scale.setScalar(finalCrystalScale);
      
      // Orbiting rings animation speed up dynamically with audio intensity
      const ringSpeed1 = 0.3 * (1.0 + audioIntensity * 2.5);
      const ringSpeed2 = 0.15 * (1.0 + audioIntensity * 2.0);
      const ringSpeed3 = 0.25 * (1.0 + audioIntensity * 2.5);
      const ringSpeed4 = 0.2 * (1.0 + audioIntensity * 2.0);

      ringMesh1.rotation.x = (time * ringSpeed1) + mouseX * 0.6;
      ringMesh1.rotation.y = (-time * ringSpeed2) + mouseY * 0.3;
      
      ringMesh2.rotation.y = (-time * ringSpeed3) - mouseX * 0.5;
      ringMesh2.rotation.z = (time * ringSpeed4) + mouseY * 0.5;

      // Animate particles with expansion + speed up driven by audio
      const pPositions = pGeo.attributes.position.array;
      for (let i = 0; i < particleCount; i++) {
        const data = pData[i];
        data.angle += data.speed * 0.015 * (1.0 + audioIntensity * 3.0);
        const currentRadius = data.radius + audioIntensity * 0.6;
        
        pPositions[i * 3] = Math.cos(data.angle) * currentRadius + mouseX * 0.25;
        pPositions[i * 3 + 1] = data.height + Math.sin(time + i) * 0.05 * (1.0 + audioIntensity * 4.0);
        pPositions[i * 3 + 2] = Math.sin(data.angle) * currentRadius + mouseY * 0.25;
      }
      pGeo.attributes.position.needsUpdate = true;
      
      renderer.render(scene, camera);
      threeAnimationId = requestAnimationFrame(animate);
    }
    
    animate();
  }

  // -------------------------------------------------------------
  // FUTURISTIC IDE INTERACTIVE WORKSPACE ORCHESTRATOR
  // -------------------------------------------------------------
  function initWorkbenchTabs() {
    const treeItems = document.querySelectorAll('.tree-item');
    const tabTitle = document.getElementById('active-tab-title');
    
    const fileCodes = {
      'hologram': 'prism.three',
      'audio': 'player.html',
      'lupino': 'lupino.html'
    };

    treeItems.forEach(item => {
      // Guard to prevent multiple bindings to the same items
      if (item.getAttribute('data-tabs-bound')) return;
      item.setAttribute('data-tabs-bound', 'true');

      item.addEventListener('click', () => {
        const targetFile = item.getAttribute('data-file');
        
        // Update active sidebar file node
        treeItems.forEach(t => t.classList.remove('active'));
        item.classList.add('active');
        
        // Update Editor Tab title
        if (tabTitle) {
          tabTitle.innerText = fileCodes[targetFile];
        }

        // Hide all code viewports and preview boxes
        document.querySelectorAll('.code-viewport').forEach(c => c.style.display = 'none');
        document.querySelectorAll('.preview-container').forEach(p => {
          p.classList.remove('active');
          p.style.display = 'none';
        });

        // Show selected file code
        const codeElem = document.getElementById(`code-${targetFile}`);
        if (codeElem) codeElem.style.display = 'block';

        // Show selected render panel
        const previewElem = document.getElementById(`preview-${targetFile}`);
        if (previewElem) {
          previewElem.style.display = 'block';
          previewElem.offsetHeight; // Force reflow
          previewElem.classList.add('active');
        }

        // Auto restart/re-init Three.js when switching back to the hologram tab
        if (targetFile === 'hologram') {
          initThreePlayground();
        }
      });
    });
  }

  // Hook into initial tab load and click switches
  window.addEventListener('load', () => {
    setTimeout(() => {
      initThreePlayground();
      initWorkbenchTabs();
    }, 100);
  });

  document.addEventListener('lens-changed', (e) => {
    if (e.detail && e.detail.lens !== 'frontend') {
      if (typeof window.stopAudioSync === 'function') {
        window.stopAudioSync();
      }
    } else if (e.detail && e.detail.lens === 'frontend') {
      setTimeout(() => {
        // Only initialize Three if hologram (prism.three) is the active tab
        const hologramTab = document.querySelector('.tree-item[data-file="hologram"]');
        if (hologramTab && hologramTab.classList.contains('active')) {
          initThreePlayground();
        }
        initWorkbenchTabs();
      }, 100);
    }
  });
</script>
