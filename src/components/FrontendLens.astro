---
// Frontend Lens Astro Component
---

<!-- Import Three.js CDN Library at the top of the frontend component -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>

<div class="frontend-lens-root">
  <!-- Futuristic Mock IDE & Live Preview Workbench -->
  <section class="workbench-section">
    <div class="workbench-header">
      <div class="workbench-dots">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </div>
      <div class="workbench-title">Edwin_Ily // Frontend Workbench v2.6</div>
      <div class="workbench-status">● LOCAL_DEV_SERVER_PORT_4321</div>
    </div>

    <div class="workbench-grid">
      <!-- Sidebar / File Explorer -->
      <aside class="workbench-sidebar">
        <div class="sidebar-header">EXPLORER // SRC</div>
        <ul class="file-tree">
          <li class="tree-item active" data-file="hologram">
            <span class="file-icon hologram">💎</span>
            <span class="file-name">prism.three</span>
          </li>
          <li class="tree-item" data-file="audio">
            <span class="file-icon audio">🎵</span>
            <span class="file-name">player.html</span>
          </li>
          <li class="tree-item" data-file="lupino">
            <span class="file-icon lupino">🗺️</span>
            <span class="file-name">lupino.html</span>
          </li>
        </ul>
      </aside>

      <!-- Project Information / Control Panel Pane -->
      <div class="workbench-editor">
        <div class="editor-tabs">
          <div class="editor-tab active" id="active-tab-title">prism.three</div>
        </div>
        
        <!-- Info Content Areas (hidden/shown based on selected file) -->
        <div class="code-viewport" id="code-hologram">
          <div class="project-info-pane">
            <div class="project-info-header">
              <span class="info-badge">💎 WEBGL & REAL-TIME AUDIO API</span>
              <h3>Visor Holográfico Prism</h3>
            </div>
            <p class="project-info-desc">
              Un visor interactivo tridimensional de alto rendimiento que integra gráficos GPU acelerados con Three.js y captura de frecuencias de sonido mediante la Web Audio API. Analiza las vibraciones acústicas del ordenador y las traduce en latidos elásticos, pulsaciones cromáticas y órbitas dinámicas de partículas en tiempo real.
            </p>
            
            <div class="project-info-controls">
              <div class="control-item">
                <div class="control-header">
                  <label for="audio-sensitivity-slider">Sensibilidad del Umbral (Gain)</label>
                  <span class="control-val" id="val-sensitivity">1.4x</span>
                </div>
                <input type="range" id="audio-sensitivity-slider" min="0.5" max="3.0" step="0.1" value="1.4" class="fe-slider" />
                <span class="slider-helper">Desliza para ajustar la ganancia y adaptar la respuesta de las pulsaciones del cristal a la intensidad del sonido.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="code-viewport" id="code-audio" style="display:none;">
          <div class="project-info-pane">
            <div class="project-info-header">
              <span class="info-badge">🎵 AUDIO VISUALIZER GRAPHICS</span>
              <h3>Reproductor Glassmorphic</h3>
            </div>
            <p class="project-info-desc">
              Un widget de reproducción de audio digital estructurado con diseño de interfaz translúcida (Glassmorphism). Dispone de un ecualizador de frecuencias de 7 bandas interactivo, el cual simula una reproducción acústica mediante animaciones o interactúa directamente con la Web Audio API cuando el ecualizador real está encendido.
            </p>
          </div>
        </div>

        <div class="code-viewport" id="code-lupino" style="display:none;">
          <div class="project-info-pane">
            <div class="project-info-header">
              <span class="info-badge">🗺️ GEOLOCATION & GASTROMAP</span>
              <h3>Lupino de Altura</h3>
            </div>
            <p class="project-info-desc">
              Una single-page application diseñada para una ruta turística y gastronómica. Incorpora un mapa interactivo detallado que geolocaliza y describe visualmente todos los puntos de interés, platillos tradicionales y paradas sugeridas propuestos por estudiantes de gastronomía para esta ruta única.
            </p>
            <div class="project-info-controls">
              <a href="https://landingpage-lupino.vercel.app" target="_blank" rel="noopener noreferrer" class="visit-site-btn">
                <span>Visitar Sitio Web</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow-icon">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Live Render Preview Pane -->
      <section class="workbench-preview">
        <div class="preview-header">LIVE RENDER VIEWPORT</div>
        
        <!-- Live content areas mapping to the active files -->
        
        <!-- Content 0: 3D Hologram Prism -->
        <div class="preview-container active" id="preview-hologram">
          <div class="frontend-3d-viewport" title="Click to pulse the holographic crystal">
            <div class="threejs-glow-effect"></div>
            <button id="three-audio-sync-btn" class="three-audio-sync-btn" title="Sincronizar con la música del ordenador">
              <span class="sync-dot"></span>
              <span class="sync-text">🎤 Sincronizar Música</span>
            </button>
            <canvas id="three-playground-canvas" class="three-canvas"></canvas>
          </div>
        </div>

        <!-- Content 1: Audio Player Sandbox -->
        <div class="preview-container" id="preview-audio" style="display:none;">
          <div class="sandbox-inner center-content">
            <div class="widget-meta">EXPERIMENT #01</div>
            <h3>Glass Audio Player</h3>
            <p class="widget-desc">Frosted UI containing dynamic visualizers. Click to simulate active track playback.</p>
            
            <div class="audio-player-card">
              <div class="audio-info">
                <div class="audio-art">🎵</div>
                <div class="audio-text">
                  <span class="track-title">Creative Coding.mp3</span>
                  <span class="track-artist">Astro Beats Subsystem</span>
                </div>
              </div>
              
              <!-- Pulsing Audio Bars -->
              <div class="audio-visualizer" id="visualizer-bars">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
              </div>

              <div class="audio-controls">
                <button class="play-btn" id="audio-play-toggle">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="play-icon">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </button>
                <div class="audio-progress-bar">
                  <div class="progress-fill" id="audio-progress" style="width: 35%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Content 2: Lupino de Altura Live Map Site Preview -->
        <div class="preview-container" id="preview-lupino" style="display:none;">
          <div class="sandbox-inner" style="height: 100%; display: flex; flex-direction: column;">
            <div class="widget-meta">EXPERIMENT #02 // LIVE SITE PREVIEW</div>
            <iframe src="https://landingpage-lupino.vercel.app" class="lupino-iframe" title="Lupino de Altura Live Site"></iframe>
          </div>
        </div>
      </section>
    </div>
  </section>
</div>

<style>
  /* -------------------------------------------------------------
     FRONTEND PERSPECTIVE BASE
     ------------------------------------------------------------- */
  .frontend-lens-root {
    padding: 5rem 2rem 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    box-sizing: border-box;
    font-family: var(--fe-font-sans);
  }

  /* Single Column Hero Title Container */
  .frontend-intro-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    text-align: left;
  }

  .frontend-3d-viewport {
    position: relative;
    width: 100%;
    height: 300px;
    background: rgba(139, 92, 246, 0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--user-radius);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: inset 0 0 30px rgba(139, 92, 246, 0.04);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .frontend-3d-viewport:hover {
    border-color: var(--accent-color);
    box-shadow: inset 0 0 45px rgba(139, 92, 246, 0.08), 0 10px 25px rgba(139, 92, 246, 0.02);
  }

  .three-canvas {
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
    z-index: 2;
    position: relative;
  }

  .threejs-glow-effect {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(192, 132, 252, 0.14) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .prism-overlay-label {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 0.62rem;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.1em;
    z-index: 5;
    pointer-events: none;
    text-transform: uppercase;
    background: rgba(6, 3, 13, 0.6);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  /* Audio Sync Glassmorphic Button Overlay */
  .three-audio-sync-btn {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(6, 3, 13, 0.7);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    color: var(--text-color);
    font-family: var(--fe-font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .three-audio-sync-btn:hover {
    border-color: var(--accent-color);
    background: rgba(139, 92, 246, 0.15);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(139, 92, 246, 0.25);
  }

  .three-audio-sync-btn.active {
    border-color: #FF007A;
    background: rgba(255, 0, 122, 0.15);
    box-shadow: 0 0 15px rgba(255, 0, 122, 0.4);
    color: #FFFFFF;
  }

  .sync-dot {
    width: 6px;
    height: 6px;
    background-color: var(--text-muted);
    border-radius: 50%;
    display: inline-block;
    transition: background-color 0.3s ease;
  }

  .three-audio-sync-btn.active .sync-dot {
    background-color: #FF007A;
    animation: syncDotPulse 1.2s infinite alternate;
  }

  @keyframes syncDotPulse {
    0% { transform: scale(0.8); opacity: 0.5; box-shadow: 0 0 0 rgba(255, 0, 122, 0); }
    100% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 8px rgba(255, 0, 122, 1); }
  }

  .fe-title {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #FFFFFF 30%, var(--accent-color) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .fe-desc {
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    max-width: 850px;
  }

  .highlight-fe {
    color: var(--accent-color);
    font-weight: 600;
  }

  /* -------------------------------------------------------------
     FUTURISTIC WORKBENCH IDE
     ------------------------------------------------------------- */
  .workbench-section {
    background: rgba(6, 3, 13, 0.4);
    border: 1px solid var(--border-color);
    border-radius: var(--user-radius);
    overflow: hidden;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .workbench-header {
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-color);
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .workbench-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0.8;
  }

  .dot.red { background: #FF5F56; }
  .dot.yellow { background: #FFBD2E; }
  .dot.green { background: #27C93F; }

  .workbench-title {
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .workbench-status {
    color: var(--accent-color);
    font-weight: 700;
  }

  .workbench-grid {
    display: grid;
    grid-template-columns: 220px 1.1fr 1fr;
    height: 72vh; /* Responsive height depending on screen size */
    min-height: 480px;
    max-height: 850px;
  }

  /* Workbench Sidebar Explorer */
  .workbench-sidebar {
    background: rgba(0, 0, 0, 0.2);
    border-right: 1px solid var(--border-color);
    padding: 1.5rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-header {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    padding-left: 1rem;
    margin-bottom: 0.5rem;
  }

  .file-tree {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tree-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }

  .tree-item:hover {
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-color);
  }

  .tree-item.active {
    background: rgba(139, 92, 246, 0.08);
    color: #FFFFFF;
    border-left: 2px solid var(--accent-color);
    border-radius: 0 6px 6px 0;
  }

  .file-icon {
    font-size: 1rem;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .tree-item:hover .file-icon {
    transform: scale(1.15);
  }

  /* Code Editor Pane */
  .workbench-editor {
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    background: rgba(0,0,0,0.05);
    overflow: hidden;
  }

  .editor-tabs {
    background: rgba(0, 0, 0, 0.15);
    border-bottom: 1px solid var(--border-color);
    display: flex;
  }

  .editor-tab {
    padding: 0.75rem 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-color);
    border-right: 1px solid var(--border-color);
    background: rgba(255,255,255,0.02);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .code-viewport {
    flex: 1;
    margin: 0;
    padding: 2rem;
    overflow-x: auto;
    overflow-y: auto;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #C9D1D9;
    background: transparent;
  }

  /* Code Syntax Highlighting colors */
  .code-comment { color: #8B949E; font-style: italic; }
  .code-keyword { color: #FF7B72; font-weight: bold; }
  .code-variable { color: #79C0FF; }
  .code-string { color: #A5D6FF; }
  .code-number { color: #D2A8FF; }
  .code-property { color: #7EE787; }
  .code-function { color: #D2A8FF; }

  /* Live Render Preview Pane */
  .workbench-preview {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: radial-gradient(circle at 90% 90%, rgba(139, 92, 246, 0.03) 0%, transparent 60%);
  }

  .preview-header {
    background: rgba(0, 0, 0, 0.15);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 1.5rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-color);
  }

  .preview-container {
    flex: 1;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow-y: auto; /* Internal scrolling to avoid main page scrollbar */
    animation: fadeInPreview 0.4s ease forwards;
  }

  @keyframes fadeInPreview {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .sandbox-inner {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .sandbox-inner.center-content {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .sandbox-sliders {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .control-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .control-val {
    color: var(--accent-color);
  }

  .fe-slider {
    -webkit-appearance: none;
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    outline: none;
  }

  .fe-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-color);
    cursor: pointer;
    box-shadow: 0 0 10px var(--accent-color);
    transition: transform 0.2s ease;
  }

  .fe-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .reset-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--user-radius);
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    font-family: var(--fe-font-sans);
  }

  .reset-btn:hover {
    border-color: var(--accent-color);
    background: rgba(139, 92, 246, 0.05);
  }

  /* Mock Card widget styles */
  .mock-widget {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--user-radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    transition: border-radius 0.3s ease;
  }

  .mock-badge {
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(139, 92, 246, 0.1);
    color: var(--fe-accent);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .mock-widget h4 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .mock-widget p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .mock-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-color);
    padding-top: 0.6rem;
    margin-top: 0.4rem;
  }

  /* Micro interactions widget styles */
  .widget-meta {
    font-size: 0.7rem;
    color: var(--accent-color);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .widget-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.2rem;
    max-width: 320px;
  }

  .widget-action-box {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }

  .magnetic-btn {
    background: var(--accent-color);
    border: none;
    outline: none;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.75rem 1.6rem;
    border-radius: var(--user-radius);
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(139, 92, 246, 0.25);
    transition: box-shadow 0.3s ease, background 0.3s ease;
    position: relative;
    font-family: var(--fe-font-sans);
  }

  /* Audio player sub-card */
  .audio-player-card {
    background: rgba(255,255,255,0.01);
    border: 1px solid var(--border-color);
    border-radius: var(--user-radius);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 320px;
    text-align: left;
  }

  .audio-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .audio-art {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--accent-color), var(--secondary-color));
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  }

  .audio-text {
    display: flex;
    flex-direction: column;
  }

  .track-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: #FFFFFF;
  }

  .track-artist {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  /* Dynamic visualizer */
  .audio-visualizer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 20px;
    padding: 0 8px;
  }

  .audio-visualizer .bar {
    width: 3px;
    height: 3px;
    background: var(--accent-color);
    border-radius: 10px;
    transition: height 0.25s ease;
  }

