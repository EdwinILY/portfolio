---
// Frontend Lens Astro Component

const codeDesignSystem = `<span class="code-comment">/* --- DESIGN SYSTEM variables --- */</span>
<span class="code-keyword">:root</span> {
  <span class="code-variable">--fe-primary</span>: <span class="code-string">hsl(0, 100%, 50%)</span>;
  <span class="code-variable">--user-radius</span>: <span class="code-number">12px</span>;
  <span class="code-variable">--user-scale</span>: <span class="code-number">1.0</span>;
}

<span class="code-keyword">.mock-widget</span> {
  <span class="code-property">border-radius</span>: <span class="code-variable">var(--user-radius)</span>;
  <span class="code-property">font-size</span>: <span class="code-function">calc</span>(<span class="code-number">1rem</span> * <span class="code-variable">var(--user-scale)</span>);
  <span class="code-property">border</span>: <span class="code-number">1px</span> solid <span class="code-string">var(--fe-primary)</span>;
}`;

const codeMagnetic = `<span class="code-comment">// --- ELASTIC CURSOR ATTRACTION ---</span>
<span class="code-keyword">const</span> magBtn = document.<span class="code-function">getElementById</span>(<span class="code-string">'magnetic-btn'</span>);

magBtn.<span class="code-function">addEventListener</span>(<span class="code-string">'mousemove'</span>, (e) => {
  <span class="code-keyword">const</span> rect = magBtn.<span class="code-function">getBoundingClientRect</span>();
  <span class="code-keyword">const</span> x = e.clientX - rect.left - rect.width / 2;
  <span class="code-keyword">const</span> y = e.clientY - rect.top - rect.height / 2;

  <span class="code-comment">// Attract button by 35% of vector distance</span>
  magBtn.style.transform = <span class="code-string">\`translate3d(\${x * 0.35}px, \${y * 0.35}px, 0)\`</span>;
});`;

const codeAudio = `<span class="code-comment">&lt;!-- --- GLASS AUDIO WIDGET --- --&gt;</span>
<span class="code-keyword">&lt;div</span> <span class="code-variable">class</span>=<span class="code-string">"audio-player-card"</span><span class="code-keyword">&gt;</span>
  <span class="code-keyword">&lt;div</span> <span class="code-variable">class</span>=<span class="code-string">"audio-visualizer"</span><span class="code-keyword">&gt;</span>
    <span class="code-keyword">&lt;span</span> <span class="code-variable">class</span>=<span class="code-string">"bar"</span><span class="code-keyword">&gt;&lt;/span&gt;</span>
  <span class="code-keyword">&lt;/div&gt;</span>
  <span class="code-keyword">&lt;button</span> <span class="code-variable">id</span>=<span class="code-string">"audio-play-toggle"</span><span class="code-keyword">&gt;</span>Play<span class="code-keyword">&lt;/button&gt;</span>
<span class="code-keyword">&lt;/div&gt;</span>`;

const codeAccordion = `{
  <span class="code-keyword">"accordionItems"</span>: [
    {
      <span class="code-variable">"title"</span>: <span class="code-string">"Optimized Rendering Flow"</span>,
      <span class="code-variable">"content"</span>: <span class="code-string">"Uses GPU-accelerated translate3d composites..."</span>
    },
    {
      <span class="code-variable">"title"</span>: <span class="code-string">"TypeScript Safety Net"</span>,
      <span class="code-variable">"content"</span>: <span class="code-string">"Strict structural typing rules..."</span>
    }
  ]
}`;
---

<!-- Import Three.js CDN Library at the top of the frontend component -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>

<div class="frontend-lens-root">
  <!-- Intro Hero with Responsive Layout -->
  <section class="frontend-intro-container">
    <div class="frontend-intro-text">
      <div class="meta-label">💻 INTERACTIVE WORKBENCH & HOLOGRAPHICS</div>
      <h1 class="fe-title">Frontend Design Systems</h1>
      <p class="fe-desc">
        Bridging the gap between strict logic and artistic fluid kinetics. This interactive workbench simulates a developer IDE environment integrated with a real-time component sandbox and a lightweight WebGL holographic crystal prism.
      </p>
    </div>

    <!-- Holographic 3D Prism Viewport -->
    <div class="frontend-3d-viewport" title="Click to pulse the holographic crystal">
      <div class="threejs-glow-effect"></div>
      <div class="prism-overlay-label">REFRACTIVE KINETIC PRISM</div>
      <canvas id="three-playground-canvas" class="three-canvas"></canvas>
    </div>
  </section>

  <!-- Futuristic Mock IDE & Live Preview Workbench -->
  <section class="workbench-section">
    <div class="workbench-header">
      <div class="workbench-dots">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
      </div>
      <div class="workbench-title">Edwin_Ily // Frontend Workbench v2.6</div>
      <div class="workbench-status">● LOCAL_DEV_SERVER_PORT_4321</div>
    </div>

    <div class="workbench-grid">
      <!-- Sidebar / File Explorer -->
      <aside class="workbench-sidebar">
        <div class="sidebar-header">EXPLORER // SRC</div>
        <ul class="file-tree">
          <li class="tree-item active" data-file="design-system">
            <span class="file-icon accent">🎨</span>
            <span class="file-name">index.css</span>
          </li>
          <li class="tree-item" data-file="magnetic">
            <span class="file-icon magnetic">🧲</span>
            <span class="file-name">magnetic.ts</span>
          </li>
          <li class="tree-item" data-file="audio">
            <span class="file-icon audio">🎵</span>
            <span class="file-name">player.html</span>
          </li>
          <li class="tree-item" data-file="accordion">
            <span class="file-icon accordion">📁</span>
            <span class="file-name">accordions.json</span>
          </li>
        </ul>
      </aside>

      <!-- Code Editor Pane -->
      <div class="workbench-editor">
        <div class="editor-tabs">
          <div class="editor-tab active" id="active-tab-title">index.css</div>
        </div>
        
        <!-- Code Content Areas (hidden/shown based on selected file) -->
        <pre class="code-viewport" id="code-design-system"><code set:html={codeDesignSystem}></code></pre>

        <pre class="code-viewport" id="code-magnetic" style="display:none;"><code set:html={codeMagnetic}></code></pre>

        <pre class="code-viewport" id="code-audio" style="display:none;"><code set:html={codeAudio}></code></pre>

        <pre class="code-viewport" id="code-accordion" style="display:none;"><code set:html={codeAccordion}></code></pre>
      </div>

      <!-- Live Render Preview Pane -->
      <section class="workbench-preview">
        <div class="preview-header">LIVE RENDER VIEWPORT</div>
        
        <!-- Live content areas mapping to the active files -->
        
        <!-- Content 1: Design System Sandbox -->
        <div class="preview-container active" id="preview-design-system">
          <div class="sandbox-inner">
            <div class="sandbox-sliders">
              <div class="control-item">
                <div class="control-header">
                  <label for="accent-hue">Primary Color Hue</label>
                  <span class="control-val" id="val-hue">0°</span>
                </div>
                <input type="range" id="accent-hue" min="0" max="360" value="0" class="fe-slider" />
              </div>

              <div class="control-item">
                <div class="control-header">
                  <label for="border-radius">Interface Border Radius</label>
                  <span class="control-val" id="val-radius">12px</span>
                </div>
                <input type="range" id="border-radius" min="0" max="36" value="12" class="fe-slider" />
              </div>

              <div class="control-item">
                <div class="control-header">
                  <label for="font-scale">Global Font Scale</label>
                  <span class="control-val" id="val-scale">1.0x</span>
                </div>
                <input type="range" id="font-scale" min="0.8" max="1.3" step="0.05" value="1.0" class="fe-slider" />
              </div>
              
              <button class="reset-btn" id="reset-sandbox">Reset Canvas</button>
            </div>

            <!-- Preview Card -->
            <div class="mock-widget">
              <div class="mock-badge">ACTIVE PREVIEW</div>
              <h4>Interactive Card Design</h4>
              <p>This panel adapts organically to your adjustments. The border rounding, typography scaling, and accent colors change globally across the DOM.</p>
              <div class="mock-footer">
                <span>Edwin Ily</span>
                <span>May 2026</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Content 2: Magnetic Button Sandbox -->
        <div class="preview-container" id="preview-magnetic" style="display:none;">
          <div class="sandbox-inner center-content">
            <div class="widget-meta">EXPERIMENT #01</div>
            <h3>Magnetic Attraction</h3>
            <p class="widget-desc">This button attracts itself to your cursor coordinates. Hover and move close to feel the elastic spring tension.</p>
            <div class="widget-action-box">
              <button class="magnetic-btn" id="magnetic-btn">
                <span class="magnetic-text">Attract Cursor</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Content 3: Audio Player Sandbox -->
        <div class="preview-container" id="preview-audio" style="display:none;">
          <div class="sandbox-inner center-content">
            <div class="widget-meta">EXPERIMENT #02</div>
            <h3>Glass Audio Player</h3>
            <p class="widget-desc">Frosted UI containing dynamic visualizers. Click to simulate active track playback.</p>
            
            <div class="audio-player-card">
              <div class="audio-info">
                <div class="audio-art">🎵</div>
                <div class="audio-text">
                  <span class="track-title">Creative Coding.mp3</span>
                  <span class="track-artist">Astro Beats Subsystem</span>
                </div>
              </div>
              
              <!-- Pulsing Audio Bars -->
              <div class="audio-visualizer" id="visualizer-bars">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
              </div>

              <div class="audio-controls">
                <button class="play-btn" id="audio-play-toggle">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="play-icon">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </button>
                <div class="audio-progress-bar">
                  <div class="progress-fill" id="audio-progress" style="width: 35%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Content 4: Accordion Sandbox -->
        <div class="preview-container" id="preview-accordion" style="display:none;">
          <div class="sandbox-inner">
            <div class="widget-meta">EXPERIMENT #03</div>
            <h3>Elastic Accordion</h3>
            <p class="widget-desc">A grid structure testing fluid CSS height calculation and spring transition-timing functions.</p>
            
            <div class="accordion-group">
              <div class="accordion-item">
                <button class="accordion-trigger" data-acc="1">
                  <span>Optimized Rendering Flow</span>
                  <span class="acc-chevron">▼</span>
                </button>
                <div class="accordion-panel" id="acc-panel-1">
                  <p>Uses GPU-accelerated translate3d composites and critical CSS paths to ensure 60fps renders on low-end mobile devices.</p>
                </div>
              </div>

              <div class="accordion-item">
                <button class="accordion-trigger" data-acc="2">
                  <span>TypeScript Safety Net</span>
                  <span class="acc-chevron">▼</span>
                </button>
                <div class="accordion-panel" id="acc-panel-2">
                  <p>Strict structural typing rules combined with compile-time schemas to guarantee component prop validity and avoid runtime regressions.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>
</div>

<style>
  /* -------------------------------------------------------------
     FRONTEND PERSPECTIVE BASE
     ------------------------------------------------------------- */
  .frontend-lens-root {
    padding: 7rem 2rem 5rem;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    font-family: var(--fe-font-sans);
  }

  /* 2-Column Responsive Hero Container */
  .frontend-intro-container {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3.5rem;
    align-items: center;
    width: 100%;
  }

  .frontend-3d-viewport {
    position: relative;
    width: 100%;
    height: 300px;
    background: rgba(139, 92, 246, 0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--user-radius);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: inset 0 0 30px rgba(139, 92, 246, 0.04);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .frontend-3d-viewport:hover {
    border-color: var(--accent-color);
    box-shadow: inset 0 0 45px rgba(139, 92, 246, 0.08), 0 10px 25px rgba(139, 92, 246, 0.02);
  }

  .three-canvas {
    width: 100%;
    height: 100%;
    display: block;
    outline: none;
    z-index: 2;
    position: relative;
  }

  .threejs-glow-effect {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(192, 132, 252, 0.14) 0%, transparent 70%);
    pointer-events: none;
    z-index: 1;
  }

  .prism-overlay-label {
    position: absolute;
    top: 12px;
    right: 12px;
    font-size: 0.62rem;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.1em;
    z-index: 5;
    pointer-events: none;
    text-transform: uppercase;
    background: rgba(6, 3, 13, 0.6);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid var(--border-color);
  }

  .fe-title {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #FFFFFF 30%, var(--accent-color) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .fe-desc {
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-color);
    max-width: 850px;
  }

  .highlight-fe {
    color: var(--accent-color);
    font-weight: 600;
  }

  /* -------------------------------------------------------------
     FUTURISTIC WORKBENCH IDE
     ------------------------------------------------------------- */
  .workbench-section {
    background: rgba(6, 3, 13, 0.4);
    border: 1px solid var(--border-color);
    border-radius: var(--user-radius);
    overflow: hidden;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .workbench-header {
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-color);
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .workbench-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    opacity: 0.8;
  }

  .dot.red { background: #FF5F56; }
  .dot.yellow { background: #FFBD2E; }
  .dot.green { background: #27C93F; }

  .workbench-title {
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .workbench-status {
    color: var(--accent-color);
    font-weight: 700;
  }

  .workbench-grid {
    display: grid;
    grid-template-columns: 220px 1.1fr 1fr;
    min-height: 480px;
  }

  /* Workbench Sidebar Explorer */
  .workbench-sidebar {
    background: rgba(0, 0, 0, 0.2);
    border-right: 1px solid var(--border-color);
    padding: 1.5rem 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sidebar-header {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    padding-left: 1rem;
    margin-bottom: 0.5rem;
  }

  .file-tree {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tree-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }

  .tree-item:hover {
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-color);
  }

  .tree-item.active {
    background: rgba(139, 92, 246, 0.08);
    color: #FFFFFF;
    border-left: 2px solid var(--accent-color);
    border-radius: 0 6px 6px 0;
  }

  .file-icon {
    font-size: 1rem;
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .tree-item:hover .file-icon {
    transform: scale(1.15);
  }

  /* Code Editor Pane */
  .workbench-editor {
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    background: rgba(0,0,0,0.05);
    overflow: hidden;
  }

  .editor-tabs {
    background: rgba(0, 0, 0, 0.15);
    border-bottom: 1px solid var(--border-color);
    display: flex;
  }

  .editor-tab {
    padding: 0.75rem 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-color);
    border-right: 1px solid var(--border-color);
    background: rgba(255,255,255,0.02);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .code-viewport {
    flex: 1;
    margin: 0;
    padding: 2rem;
    overflow-x: auto;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #C9D1D9;
    background: transparent;
  }

  /* Code Syntax Highlighting colors */
  .code-comment { color: #8B949E; font-style: italic; }
  .code-keyword { color: #FF7B72; font-weight: bold; }
  .code-variable { color: #79C0FF; }
  .code-string { color: #A5D6FF; }
  .code-number { color: #D2A8FF; }
  .code-property { color: #7EE787; }
  .code-function { color: #D2A8FF; }

  /* Live Render Preview Pane */
  .workbench-preview {
    display: flex;
    flex-direction: column;
    background: radial-gradient(circle at 90% 90%, rgba(139, 92, 246, 0.03) 0%, transparent 60%);
  }

  .preview-header {
    background: rgba(0, 0, 0, 0.15);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 1.5rem;
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-color);
  }

  .preview-container {
    flex: 1;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    animation: fadeInPreview 0.4s ease forwards;
  }

  @keyframes fadeInPreview {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .sandbox-inner {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .sandbox-inner.center-content {
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .sandbox-sliders {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .control-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .control-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .control-val {
    color: var(--accent-color);
  }

  .fe-slider {
    -webkit-appearance: none;
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    outline: none;
  }

  .fe-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-color);
    cursor: pointer;
    box-shadow: 0 0 10px var(--accent-color);
    transition: transform 0.2s ease;
  }

  .fe-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  .reset-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-color);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--user-radius);
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    font-family: var(--fe-font-sans);
  }

  .reset-btn:hover {
    border-color: var(--accent-color);
    background: rgba(139, 92, 246, 0.05);
  }

  /* Mock Card widget styles */
  .mock-widget {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    border-radius: var(--user-radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    transition: border-radius 0.3s ease;
  }

  .mock-badge {
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 700;
    background: rgba(139, 92, 246, 0.1);
    color: var(--fe-accent);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .mock-widget h4 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .mock-widget p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .mock-footer {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-color);
    padding-top: 0.6rem;
    margin-top: 0.4rem;
  }

  /* Micro interactions widget styles */
  .widget-meta {
    font-size: 0.7rem;
    color: var(--accent-color);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .widget-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1.2rem;
    max-width: 320px;
  }

  .widget-action-box {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }

  .magnetic-btn {
    background: var(--accent-color);
    border: none;
    outline: none;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 0.75rem 1.6rem;
    border-radius: var(--user-radius);
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(139, 92, 246, 0.25);
    transition: box-shadow 0.3s ease, background 0.3s ease;
    position: relative;
    font-family: var(--fe-font-sans);
  }

  /* Audio player sub-card */
  .audio-player-card {
    background: rgba(255,255,255,0.01);
    border: 1px solid var(--border-color);
    border-radius: var(--user-radius);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 320px;
    text-align: left;
  }

  .audio-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .audio-art {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--accent-color), var(--secondary-color));
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
  }

  .audio-text {
    display: flex;
    flex-direction: column;
  }

  .track-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: #FFFFFF;
  }

  .track-artist {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  /* Dynamic visualizer */
  .audio-visualizer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 20px;
    padding: 0 8px;
  }

  .audio-visualizer .bar {
    width: 3px;
    height: 3px;
    background: var(--accent-color);
    border-radius: 10px;
    transition: height 0.25s ease;
  }

  /* Height animations when active */
  .audio-visualizer.playing .bar {
    animation: bounceVisualizer 1.2s infinite ease-in-out alternate;
  }

  .audio-visualizer.playing .bar:nth-child(2) { animation-delay: 0.15s; }
  .audio-visualizer.playing .bar:nth-child(3) { animation-delay: 0.3s; }
  .audio-visualizer.playing .bar:nth-child(4) { animation-delay: 0.45s; }
  .audio-visualizer.playing .bar:nth-child(5) { animation-delay: 0.2s; }
  .audio-visualizer.playing .bar:nth-child(6) { animation-delay: 0.35s; }
  .audio-visualizer.playing .bar:nth-child(7) { animation-delay: 0.1s; }

  @keyframes bounceVisualizer {
    0% { height: 3px; }
    100% { height: 20px; }
  }

  .audio-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .play-btn {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #FFFFFF;
    color: #0A051D;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: transform 0.2s ease;
  }

  .play-btn:hover {
    transform: scale(1.1);
  }

  .audio-progress-bar {
    flex: 1;
    height: 3px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent-color);
  }

  /* Accordion styling */
  .accordion-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
  }

  .accordion-item {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255,255,255,0.01);
  }

  .accordion-trigger {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.8rem;
    cursor: pointer;
    transition: background 0.3s ease;
    font-family: var(--fe-font-sans);
  }

  .accordion-trigger:hover {
    background: rgba(255,255,255,0.02);
  }

  .acc-chevron {
    font-size: 0.65rem;
    color: var(--accent-color);
    transition: transform 0.3s ease;
  }

  .accordion-item.active .acc-chevron {
    transform: rotate(180deg);
  }

  .accordion-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0 1rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .accordion-item.active .accordion-panel {
    max-height: 80px;
    padding-bottom: 0.75rem;
  }

  /* Responsive Adjustments */
  @media (max-width: 992px) {
    .workbench-grid {
      grid-template-columns: 180px 1fr;
    }
    .workbench-editor {
      display: none; /* Hide code editor on tablets to keep it tidy */
    }
  }

  @media (max-width: 768px) {
    .frontend-intro-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .frontend-3d-viewport {
      height: 240px;
    }

    .fe-title {
      font-size: 2.5rem;
    }
    
    .workbench-grid {
      grid-template-columns: 1fr;
    }
    .workbench-sidebar {
      border-right: none;
      border-bottom: 1px solid var(--border-color);
      flex-direction: row;
      overflow-x: auto;
      padding: 0.8rem;
    }
    .file-tree {
      flex-direction: row;
      gap: 8px;
    }
    .tree-item {
      padding: 0.4rem 0.75rem;
      white-space: nowrap;
    }
  }
</style>

<script is:inline>
  // -------------------------------------------------------------
  // THREE.JS HOLOGRAPHIC CRYSTAL PRISM VIEWPORT
  // -------------------------------------------------------------
  let threeAnimationId = null;

  function initThreePlayground() {
    if (threeAnimationId) {
      cancelAnimationFrame(threeAnimationId);
      threeAnimationId = null;
    }
    
    const canvas = document.getElementById('three-playground-canvas');
    if (!canvas || !window.THREE) return;
    
    const container = canvas.parentElement;
    const THREE = window.THREE;
    
    // Scene creation
    const scene = new THREE.Scene();
    
    // WebGL Renderer Setup (alpha transparency for seamless look)
    const renderer = new THREE.WebGLRenderer({
      canvas: canvas,
      alpha: true,
      antialias: true
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);
    
    // Camera Setup
    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.z = 5.2;
    
    // Lights Setup (Ambient + Dual colored point lights)
    const ambientLight = new THREE.AmbientLight(0x0a051d, 3.0);
    scene.add(ambientLight);
    
    const pointLight1 = new THREE.PointLight(0x8B5CF6, 4.0, 15); // Neon Purple
    pointLight1.position.set(2.5, 3.0, 2.0);
    scene.add(pointLight1);
    
    const pointLight2 = new THREE.PointLight(0x00E5FF, 3.0, 15); // Cyber Cyan
    pointLight2.position.set(-2.5, -3.0, 2.0);
    scene.add(pointLight2);
    
    // Geometries
    // Center faceted Crystal Prism (Octahedron has 8 flat glass faces - highly performant!)
    const crystalGeo = new THREE.OctahedronGeometry(1.2, 0);
    const crystalMat = new THREE.MeshPhongMaterial({
      color: 0x06030c,
      emissive: 0x110724,
      specular: 0x8B5CF6,
      shininess: 90,
      flatShading: true // Gives a stunning low-poly glass refraction look
    });
    const crystalMesh = new THREE.Mesh(crystalGeo, crystalMat);
    scene.add(crystalMesh);
    
    // Double orbital refraction rings (representing light rays)
    const ringGeo1 = new THREE.TorusGeometry(1.65, 0.012, 8, 48);
    const ringMat1 = new THREE.MeshBasicMaterial({
      color: 0x8B5CF6,
      transparent: true,
      opacity: 0.4
    });
    const ringMesh1 = new THREE.Mesh(ringGeo1, ringMat1);
    ringMesh1.rotation.x = Math.PI / 2.5;
    scene.add(ringMesh1);

    const ringGeo2 = new THREE.TorusGeometry(1.8, 0.01, 8, 48);
    const ringMat2 = new THREE.MeshBasicMaterial({
      color: 0x00E5FF,
      transparent: true,
      opacity: 0.3
    });
    const ringMesh2 = new THREE.Mesh(ringGeo2, ringMat2);
    ringMesh2.rotation.y = Math.PI / 3.0;
    scene.add(ringMesh2);

    // Subtle Particle Swarm
    const particleCount = 45;
    const pGeo = new THREE.BufferGeometry();
    const pPos = new Float32Array(particleCount * 3);
    const pData = [];

    for (let i = 0; i < particleCount; i++) {
      const angle = Math.random() * Math.PI * 2;
      const radius = 1.45 + Math.random() * 1.0;
      const speed = 0.2 + Math.random() * 0.4;
      const height = (Math.random() - 0.5) * 0.8;

      pPos[i * 3] = Math.cos(angle) * radius;
      pPos[i * 3 + 1] = height;
      pPos[i * 3 + 2] = Math.sin(angle) * radius;

      pData.push({ angle, radius, speed, height });
    }

    pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
    const pMat = new THREE.PointsMaterial({
      color: 0xC084FC,
      size: 0.05,
      transparent: true,
      opacity: 0.6
    });
    const particles = new THREE.Points(pGeo, pMat);
    scene.add(particles);
    
    // Parallax interaction variables
    let mouseX = 0, mouseY = 0;
    let targetX = 0, targetY = 0;
    
    container.addEventListener('mousemove', (e) => {
      const rect = container.getBoundingClientRect();
      targetX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      targetY = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    });
    
    container.addEventListener('mouseleave', () => {
      targetX = 0;
      targetY = 0;
    });
    
    // Responsive Resize Observer
    const resizeObserver = new ResizeObserver(() => {
      if (container.clientWidth === 0 || container.clientHeight === 0) return;
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    });
    resizeObserver.observe(container);
    
    // Click action: Crystalline kinetic pulse
    let pulseScale = 1.0;
    let pulseVelocity = 0.0;
    
    container.addEventListener('click', () => {
      pulseScale = 1.45; // Expand core crystal
      pointLight1.intensity = 8.0; // Flash lighting
      pointLight2.intensity = 6.0;
      
      // Temporary ring spin speed increase
      ringMesh1.rotation.z += 1.5;
      ringMesh2.rotation.z -= 1.5;
    });
    
    const clock = new THREE.Clock();
    
    function animate() {
      // Clean exit if element is no longer attached or display:none is active
      if (!document.getElementById('three-playground-canvas') || canvas.offsetParent === null) {
        threeAnimationId = null;
        return;
      }
      
      const time = clock.getElapsedTime();
      
      // Apply spring easing to click kinetic pulse
      const springTension = 0.15;
      const springFriction = 0.8;
      
      const springForce = (1.0 - pulseScale) * springTension;
      pulseVelocity += springForce;
      pulseVelocity *= springFriction;
      pulseScale += pulseVelocity;
      
      // Gradually decay point light flashes
      pointLight1.intensity += (4.0 - pointLight1.intensity) * 0.1;
      pointLight2.intensity += (3.0 - pointLight2.intensity) * 0.1;
      
      // Apply parallax coordinates
      mouseX += (targetX - mouseX) * 0.08;
      mouseY += (targetY - mouseY) * 0.08;
      
      // Crystal slow spinning + cursor focus tracking
      crystalMesh.rotation.y = time * 0.15 + mouseX * 0.4;
      crystalMesh.rotation.x = time * 0.1 + mouseY * 0.4;
      crystalMesh.scale.setScalar(pulseScale);
      
      // Orbiting rings animation
      ringMesh1.rotation.x = (time * 0.3) + mouseX * 0.6;
      ringMesh1.rotation.y = (-time * 0.15) + mouseY * 0.3;
      
      ringMesh2.rotation.y = (-time * 0.25) - mouseX * 0.5;
      ringMesh2.rotation.z = (time * 0.2) + mouseY * 0.5;

      // Animate particles in wave paths
      const pPositions = pGeo.attributes.position.array;
      for (let i = 0; i < particleCount; i++) {
        const data = pData[i];
        data.angle += data.speed * 0.015;
        pPositions[i * 3] = Math.cos(data.angle) * data.radius + mouseX * 0.25;
        pPositions[i * 3 + 1] = data.height + Math.sin(time + i) * 0.05;
        pPositions[i * 3 + 2] = Math.sin(data.angle) * data.radius + mouseY * 0.25;
      }
      pGeo.attributes.position.needsUpdate = true;
      
      renderer.render(scene, camera);
      threeAnimationId = requestAnimationFrame(animate);
    }
    
    animate();
  }

  // -------------------------------------------------------------
  // FUTURISTIC IDE INTERACTIVE WORKSPACE ORCHESTRATOR
  // -------------------------------------------------------------
  function initWorkbenchTabs() {
    const treeItems = document.querySelectorAll('.tree-item');
    const tabTitle = document.getElementById('active-tab-title');
    
    const fileCodes = {
      'design-system': 'index.css',
      'magnetic': 'magnetic.ts',
      'audio': 'player.html',
      'accordion': 'accordions.json'
    };

    treeItems.forEach(item => {
      item.addEventListener('click', () => {
        const targetFile = item.getAttribute('data-file');
        
        // Update active sidebar file node
        treeItems.forEach(t => t.classList.remove('active'));
        item.classList.add('active');
        
        // Update Editor Tab title
        if (tabTitle) {
          tabTitle.innerText = fileCodes[targetFile];
        }

        // Hide all code viewports and preview boxes
        document.querySelectorAll('.code-viewport').forEach(c => c.style.display = 'none');
        document.querySelectorAll('.preview-container').forEach(p => {
          p.classList.remove('active');
          p.style.display = 'none';
        });

        // Show selected file code
        const codeElem = document.getElementById(`code-${targetFile}`);
        if (codeElem) codeElem.style.display = 'block';

        // Show selected render panel
        const previewElem = document.getElementById(`preview-${targetFile}`);
        if (previewElem) {
          previewElem.style.display = 'block';
          // Force reflow trigger
          previewElem.offsetHeight;
          previewElem.classList.add('active');
        }
      });
    });
  }

  // Hook into initial tab load and click switches
  window.addEventListener('load', () => {
    setTimeout(() => {
      initThreePlayground();
      initWorkbenchTabs();
    }, 100);
  });

  document.addEventListener('lens-changed', (e) => {
    if (e.detail && e.detail.lens === 'frontend') {
      setTimeout(() => {
        initThreePlayground();
        initWorkbenchTabs();
      }, 320);
    }
  });
</script>
