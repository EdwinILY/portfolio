      grid-template-columns: 1fr;
    }

    .sys-title {
      font-size: 2.5rem;
    }

    .github-profile-card {
      padding: 1.5rem;
    }

    .profile-user-info {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .user-tags {
      justify-content: center;
    }

    .sys-project-card {
      padding: 1.5rem;
    }

    .arch-btn {
      font-size: 0.75rem;
      padding: 0.6rem 0.3rem;
    }

    .terminal-card-body {
      padding: 1.5rem;
    }
  }
</style>

<script is:inline>
  // -------------------------------------------------------------
  // HIGH-FIDELITY ARCHITECTURE SWITCHER CONTROLLER
  // -------------------------------------------------------------
  function setupArchSwitchers() {
    const switchers = document.querySelectorAll('.arch-switcher');
    
    switchers.forEach(switcher => {
      const buttons = switcher.querySelectorAll('.arch-btn');
      const panes = switcher.querySelectorAll('.arch-pane');
      
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedTab = btn.getAttribute('data-tab');
          
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          
          panes.forEach(pane => {
            pane.classList.remove('active');
            if (pane.getAttribute('data-pane') === selectedTab) {
              pane.classList.add('active');
            }
          });
        });
      });
    });
  }

  // -------------------------------------------------------------
  // SECURE SHELL (SSH) COMMAND HANDLER
  // -------------------------------------------------------------
  function setupContactInteractiveNodes() {
    const sshBox = document.getElementById('ssh-box');
    const alertBox = document.getElementById('copy-alert');

    if (sshBox) {
      sshBox.addEventListener('click', () => {
        const command = "ssh visitor@portfolio.edwin.dev";
        navigator.clipboard.writeText(command).then(() => {
          if (alertBox) {
            alertBox.style.display = 'flex';
            
            setTimeout(() => {
              alertBox.style.animation = 'fadeInPane 0.3s ease reverse';
              setTimeout(() => {
                alertBox.style.display = 'none';
                alertBox.style.animation = '';
              }, 300);
            }, 3000);
          }
        });
      });
    }
  }





  // -------------------------------------------------------------
  // INTERACTIVE TOPOLOGY MAP CANVAS (2D KINETIC NETWORK MAP)
  // -------------------------------------------------------------
  let topoAnimationId = null;

  function initTopologyCanvas() {
    if (topoAnimationId) cancelAnimationFrame(topoAnimationId);

    const canvas = document.getElementById('cluster-topology-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const container = canvas.parentElement;

    function resize() {
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
    }
    resize();

    // Node definitions matching actual EdwinILY structure
    const nodes = [
      { id: 'gateway', name: 'Ingress Gateway', x: 0.15, y: 0.5, size: 10, color: '#0088FF', active: true, cpu: '4%', mem: '18 MB' },
      { id: 'virtual', name: 'AulaVirtual Java', x: 0.45, y: 0.25, size: 8, color: '#8B5CF6', active: true, cpu: '18%', mem: '124 MB' },
      { id: 'sabor', name: 'SaborCercano PHP', x: 0.45, y: 0.75, size: 8, color: '#FF7B72', active: true, cpu: '12%', mem: '68 MB' },
      { id: 'inventario', name: 'Inventario TS', x: 0.75, y: 0.35, size: 8, color: '#00F5A0', active: true, cpu: '8%', mem: '45 MB' },
      { id: 'db', name: 'PostgreSQL DB', x: 0.75, y: 0.75, size: 12, color: '#00E5FF', active: true, cpu: '22%', mem: '210 MB' },
      { id: 'uta', name: 'UTA Static CDN', x: 0.45, y: 0.5, size: 7, color: '#FFB86C', active: true, cpu: '1%', mem: '5 MB' }
    ];

    // Connection paths (Gateway routes to apps, apps to DB)
    const connections = [
      { from: 0, to: 1 },
      { from: 0, to: 2 },
      { from: 0, to: 5 },
      { from: 1, to: 4 },
      { from: 2, to: 4 },
      { from: 3, to: 4 },
      { from: 5, to: 3 }
    ];

    // Pulsating traffic impulses traveling along connection lines
    const impulses = [];
    for (let i = 0; i < 8; i++) {
      impulses.push({
        connIndex: Math.floor(Math.random() * connections.length),
        progress: Math.random(),
        speed: 0.006 + Math.random() * 0.01
      });
    }

    let hoveredNode = null;
    const popover = document.getElementById('top-popover');
    const popName = document.getElementById('pop-node-name');
    const popCpu = document.getElementById('pop-node-cpu');
    const popMem = document.getElementById('pop-node-mem');

    // Canvas mouse move tracking
    container.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;

      let found = null;
      for (const n of nodes) {
        const nx = n.x * canvas.width;
        const ny = n.y * canvas.height;
        const dist = Math.hypot(mx - nx, my - ny);
        if (dist < n.size + 15) {
          found = n;
          break;
        }
      }

      if (found) {
        hoveredNode = found;
        if (popover && popName && popCpu && popMem) {
          popName.innerText = found.name;
          popCpu.innerText = found.cpu;
          popMem.innerText = found.mem;
          popover.style.left = `${found.x * canvas.width + 15}px`;
          popover.style.top = `${found.y * canvas.height - 40}px`;
          popover.classList.add('active');
        }
      } else {
        hoveredNode = null;
        if (popover) popover.classList.remove('active');
      }
    });

    container.addEventListener('mouseleave', () => {
      hoveredNode = null;
      if (popover) popover.classList.remove('active');
    });

    function draw() {
      // exit loop if element is detached
      if (!document.getElementById('cluster-topology-canvas') || canvas.offsetParent === null) {
        topoAnimationId = null;
        return;
      }

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // 1. Draw Connection Lines
      ctx.lineWidth = 1.5;
      for (const c of connections) {
        const fromNode = nodes[c.from];
        const toNode = nodes[c.to];
        
        ctx.beginPath();
        ctx.moveTo(fromNode.x * canvas.width, fromNode.y * canvas.height);
        ctx.lineTo(toNode.x * canvas.width, toNode.y * canvas.height);
        ctx.strokeStyle = "rgba(255,255,255,0.06)";
        ctx.stroke();
      }

      // 2. Draw Moving Traffic Impulse Packets
      for (const p of impulses) {
        const conn = connections[p.connIndex];
        const fromNode = nodes[conn.from];
        const toNode = nodes[conn.to];

        const fx = fromNode.x * canvas.width;
        const fy = fromNode.y * canvas.height;
        const tx = toNode.x * canvas.width;
        const ty = toNode.y * canvas.height;

        // Linear interpolation coordinates
        const x = fx + (tx - fx) * p.progress;
        const y = fy + (ty - fy) * p.progress;

        ctx.beginPath();
        ctx.arc(x, y, 3.5, 0, Math.PI * 2);
        ctx.fillStyle = toNode.color;
        ctx.shadowColor = toNode.color;
        ctx.shadowBlur = 12;
        ctx.fill();
        ctx.shadowBlur = 0; // reset shadow glow

        // Progress packet along path
        p.progress += p.speed;
        if (p.progress >= 1.0) {
          p.progress = 0;
          p.connIndex = Math.floor(Math.random() * connections.length);
          p.speed = 0.005 + Math.random() * 0.008;
        }
      }

      // 3. Draw Nodes
      for (const n of nodes) {
        const nx = n.x * canvas.width;
        const ny = n.y * canvas.height;
        const isHovered = hoveredNode && hoveredNode.id === n.id;

        ctx.beginPath();
        ctx.arc(nx, ny, isHovered ? n.size * 1.35 : n.size, 0, Math.PI * 2);
        ctx.fillStyle = n.color;
        ctx.fill();

        // Glowing border ring
        ctx.beginPath();
        ctx.arc(nx, ny, (isHovered ? n.size * 1.35 : n.size) + 4 + Math.sin(Date.now() * 0.005) * 1.5, 0, Math.PI * 2);
        ctx.lineWidth = 1;
        ctx.strokeStyle = isHovered ? "#FFFFFF" : `${n.color}55`;
        ctx.stroke();

        // Node Label
        ctx.fillStyle = isHovered ? "#FFFFFF" : "rgba(255,255,255,0.45)";
        ctx.font = "bold 9px 'JetBrains Mono', monospace";
        ctx.textAlign = "center";
        ctx.fillText(n.name, nx, ny + n.size + 15);
      }

      topoAnimationId = requestAnimationFrame(draw);
    }

    draw();
  }

  // -------------------------------------------------------------
  // SPLIT GATEWAY HERO CANVAS ENGINES
  // -------------------------------------------------------------
  let gatewayAnimationId = null;

  function initSplitGatewayCanvases() {
    if (gatewayAnimationId) {
      cancelAnimationFrame(gatewayAnimationId);
      gatewayAnimationId = null;
    }

    const leftPortal = document.getElementById('portal-left-trigger');
    const rightPortal = document.getElementById('portal-right-trigger');

    const matrixCanvas = document.getElementById('portal-matrix-canvas');
    const wavesCanvas = document.getElementById('portal-waves-canvas');

    if (!matrixCanvas || !wavesCanvas || !leftPortal || !rightPortal) return;

    const mCtx = matrixCanvas.getContext('2d');
    const wCtx = wavesCanvas.getContext('2d');

    // Handle resizing
    function resize() {
      if (matrixCanvas && leftPortal) {
        matrixCanvas.width = leftPortal.clientWidth;
        matrixCanvas.height = leftPortal.clientHeight;
      }
      if (wavesCanvas && rightPortal) {
        wavesCanvas.width = rightPortal.clientWidth;
        wavesCanvas.height = rightPortal.clientHeight;
      }
    }
    resize();

    // --- MATRIX DIGITAL RAIN COMPONENT ---
    const fontSize = 12;
    let columns = Math.floor(matrixCanvas.width / fontSize) + 1;
    let drops = Array(columns).fill(1);
    
    // Character pool (Cyberpunk/Astro style)
    const chars = "EDWIN_STAGE_010101_K8S_GRPC_FAST_API_PNPM_VITE_ASTRO6".split("");
    let matrixSpeed = 1.0;
    let targetMatrixSpeed = 1.0;

    // --- LIQUID SINE WAVES COMPONENT ---
    let wavePhase = 0;
    let waveAmplitude = 18;
    let targetAmplitude = 18;
    let waveSpeed = 0.015;
    let targetWaveSpeed = 0.015;

    // Handle clicks to navigate programmatically to Backend or Frontend tabs
    leftPortal.addEventListener('click', (e) => {
      // Avoid firing if they click the center core (which floats over the boundary)
      if (e.target.closest('#portal-center-core')) return;
      if (window.switchLens) window.switchLens('backend');
    });

    rightPortal.addEventListener('click', (e) => {
      if (e.target.closest('#portal-center-core')) return;
      if (window.switchLens) window.switchLens('frontend');
    });

    // Toggle DevOps telemetry dashboard on center core click and sync with manual scroll position
    const centerCore = document.getElementById('portal-center-core');
    if (centerCore) {
      // Recreate to avoid duplicate event listeners if initialized multiple times
      const newCenterCore = centerCore.cloneNode(true);
      centerCore.parentNode.replaceChild(newCenterCore, centerCore);
      
      const scrollHintSpan = newCenterCore.querySelector('.core-scroll-hint span:first-child');
      const scrollHintArrow = newCenterCore.querySelector('.core-scroll-hint .hint-arrow');
      
      newCenterCore.addEventListener('click', (e) => {
        e.stopPropagation(); // Stop click propagation to portals
        const target = document.getElementById('devops-dashboard-wrapper');
        if (target) {
          const threshold = window.innerHeight * 0.4;
          const isScrolledDown = window.scrollY > threshold;
          
          if (!isScrolledDown) {
            target.scrollIntoView({ behavior: 'smooth' });
          } else {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        }
      });
      
      // Auto-sync button labels & arrows based on mouse wheel/touchpad scrolling position!
      window.addEventListener('scroll', () => {
        const threshold = window.innerHeight * 0.4;
        const isScrolledDown = window.scrollY > threshold;
        
        if (isScrolledDown) {
          if (scrollHintSpan && scrollHintSpan.textContent !== 'CLOSE TELEMETRY') {
            scrollHintSpan.textContent = 'CLOSE TELEMETRY';
            if (scrollHintArrow) scrollHintArrow.textContent = '↑';
          }
        } else {
          if (scrollHintSpan && scrollHintSpan.textContent !== 'EXPLOIT TELEMETRY') {
            scrollHintSpan.textContent = 'EXPLOIT TELEMETRY';
            if (scrollHintArrow) scrollHintArrow.textContent = '↓';
          }
        }
      });
    }

    // Animation Loop
    function loop() {
      // Check visibility - stop loop if Systems tab is hidden or canvas is removed
      if (!document.getElementById('portal-matrix-canvas') || matrixCanvas.offsetParent === null) {
        gatewayAnimationId = null;
        return;
      }

      // Re-evaluate dimensions to check for layout shifts
      if (matrixCanvas.width !== leftPortal.clientWidth || wavesCanvas.width !== rightPortal.clientWidth) {
        resize();
        columns = Math.floor(matrixCanvas.width / fontSize) + 1;
        if (drops.length !== columns) {
          drops = Array(columns).fill(1);
        }
      }

      // 1. Render Matrix Rain
      mCtx.fillStyle = 'rgba(3, 6, 11, 0.12)';
      mCtx.fillRect(0, 0, matrixCanvas.width, matrixCanvas.height);

      mCtx.fillStyle = 'rgba(0, 245, 160, 0.55)'; // Light Neon Green
      mCtx.font = `bold ${fontSize}px 'JetBrains Mono', monospace`;

      // Smoothly interpolate matrix speed
      matrixSpeed += (targetMatrixSpeed - matrixSpeed) * 0.1;

      for (let i = 0; i < drops.length; i++) {
        const text = chars[Math.floor(Math.random() * chars.length)];
        const x = i * fontSize;
        const y = drops[i] * fontSize;

        // Draw character
        mCtx.fillText(text, x, y);

        // Random drop resets
        if (y > matrixCanvas.height && Math.random() > 0.985) {
          drops[i] = 0;
        }

        // Increment drop by speed factor
        drops[i] += matrixSpeed;
      }

      // 2. Render Overlapping Liquid Waves
      wCtx.clearRect(0, 0, wavesCanvas.width, wavesCanvas.height);

      // Smoothly interpolate wave parameters
      waveAmplitude += (targetAmplitude - waveAmplitude) * 0.08;
      waveSpeed += (targetWaveSpeed - waveSpeed) * 0.08;
      wavePhase += waveSpeed;

      // Draw 3 layered transparent waves (violet, magenta, cyan)
      const waveConfigs = [
        { ampMult: 1.0, freq: 0.0035, phaseOffset: 0, color: 'rgba(139, 92, 246, 0.15)' }, // Violet
        { ampMult: 0.75, freq: 0.005, phaseOffset: Math.PI * 0.4, color: 'rgba(255, 0, 122, 0.1)' }, // Magenta
        { ampMult: 0.5, freq: 0.007, phaseOffset: Math.PI * 0.8, color: 'rgba(0, 229, 255, 0.08)' }  // Cyber Cyan
      ];

      for (const w of waveConfigs) {
        wCtx.beginPath();
        wCtx.fillStyle = w.color;
        
        const baseline = wavesCanvas.height * 0.65; // Waves baseline

        wCtx.moveTo(0, wavesCanvas.height);
        
        for (let x = 0; x <= wavesCanvas.width; x += 10) {
          const y = baseline + Math.sin(x * w.freq + wavePhase + w.phaseOffset) * waveAmplitude * w.ampMult;
          wCtx.lineTo(x, y);
        }

        wCtx.lineTo(wavesCanvas.width, wavesCanvas.height);
        wCtx.closePath();
        wCtx.fill();
      }

      gatewayAnimationId = requestAnimationFrame(loop);
    }

    loop();
  }

  // -------------------------------------------------------------
  // INITIALIZATION RUNNERS
  // -------------------------------------------------------------
  window.addEventListener('load', () => {
    setTimeout(() => {
      setupArchSwitchers();
      setupContactInteractiveNodes();
      initTopologyCanvas();
      initSplitGatewayCanvases();
    }, 100);
  });

  // Re-trigger runners when the user switches to the systems lens
  document.addEventListener('lens-changed', (e) => {
    if (e.detail && e.detail.lens === 'systems') {
      setTimeout(() => {
        setupArchSwitchers();
        setupContactInteractiveNodes();
        initTopologyCanvas();
        initSplitGatewayCanvases();
      }, 350);
    }
  });

  window.addEventListener('resize', () => {
    initTopologyCanvas();
    initSplitGatewayCanvases();
  });
</script>
