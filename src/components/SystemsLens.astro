  /* -------------------------------------------------------------
     RESPONSIVE STYLING ADJUSTMENTS
     ------------------------------------------------------------- */
  @media (max-width: 992px) {
    .ops-dashboard-grid {
      grid-template-columns: 1fr;
    }
    
    .ops-metrics-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .systems-projects-grid {
      grid-template-columns: 1fr;
    }

