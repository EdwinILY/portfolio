---
// Systems & Fullstack Perspective Astro Component

// Generate dynamic, realistic GitHub contribution data for 196 days (28 weeks)
const contributions = Array(196).fill(0).map((_, i) => {
  const intensities = ['empty', 'low', 'medium', 'high', 'highest'];
  const randVal = Math.random();
  const intensity = randVal < 0.5 ? 'empty' : randVal < 0.75 ? 'low' : randVal < 0.90 ? 'medium' : randVal < 0.97 ? 'high' : 'highest';
  
  const date = new Date();
  date.setDate(date.getDate() - (195 - i));
  const dateString = date.toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' });
  
  const commitCount = intensity === 'empty' ? 0 
                     : intensity === 'low' ? Math.floor(1 + Math.random() * 2) 
                     : intensity === 'medium' ? Math.floor(3 + Math.random() * 4) 
                     : intensity === 'high' ? Math.floor(7 + Math.random() * 5) 
                     : Math.floor(12 + Math.random() * 8);

  return {
    intensity,
    dateString,
    commitCount
  };
});
