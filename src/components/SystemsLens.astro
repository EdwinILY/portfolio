<style>
  /* -------------------------------------------------------------
     SYSTEMS / PROFILE PERSPECTIVE BASE
     ------------------------------------------------------------- */
  .systems-lens-root {
    width: 100%;
    display: flex;
    flex-direction: column;
    color: var(--text-color);
    font-family: var(--sys-font-sans);
    background-color: var(--bg-color);
  }

  /* -------------------------------------------------------------
     SYMMETRICAL QUANTUM SPLIT GATEWAY HERO
     ------------------------------------------------------------- */
  .split-gateway-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    overflow: hidden;
    background: #03060b;
    border-bottom: 1px solid var(--border-color);
    margin-top: 0;
  }

  .portal-pane {
    position: relative;
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 4rem 3.5rem;
    cursor: pointer;
    transition: flex 0.8s cubic-bezier(0.16, 1, 0.3, 1), background 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  .portal-left {
    background: linear-gradient(180deg, rgba(6, 9, 15, 0.4) 0%, rgba(3, 6, 11, 0.9) 100%);
    border-right: 1px solid rgba(255, 255, 255, 0.03);
  }

  .portal-right {
    background: linear-gradient(180deg, rgba(6, 3, 13, 0.4) 0%, rgba(3, 6, 11, 0.9) 100%);
    align-items: flex-end;
  }

  .portal-right .portal-info {
    align-items: flex-end;
    text-align: right;
  }

  /* Portal canvas styling */
  .portal-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    opacity: 0.25;
    transition: opacity 0.5s ease;
  }

  .portal-pane:hover .portal-canvas {
    opacity: 0.55;
  }

  /* Pane glow overlay */
  .portal-pane-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portal-left:hover .portal-pane-glow {
    opacity: 1;
    background: radial-gradient(circle at 35% 85%, rgba(0, 245, 160, 0.05) 0%, transparent 60%);
  }

  .portal-right:hover .portal-pane-glow {
    opacity: 1;
    background: radial-gradient(circle at 65% 85%, rgba(139, 92, 246, 0.05) 0%, transparent 60%);
  }



  .portal-left:hover {
    background: linear-gradient(180deg, rgba(0, 245, 160, 0.02) 0%, rgba(6, 9, 15, 0.95) 100%);
  }

  .portal-right:hover {
    background: linear-gradient(180deg, rgba(139, 92, 246, 0.02) 0%, rgba(6, 3, 13, 0.95) 100%);
  }

  /* Portal Info Container */
  .portal-info {
    position: relative;
    z-index: 5;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    pointer-events: none;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portal-pane:hover .portal-info {
    transform: translateY(-8px);
  }

  .portal-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .portal-left .portal-tag {
    color: var(--be-primary);
  }

  .portal-right .portal-tag {
    color: var(--fe-primary);
  }

  .portal-title {
    font-family: 'Outfit', sans-serif;
    font-size: 2.85rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #FFFFFF;
    margin: 0;
  }

  .portal-left:hover .portal-title {
    text-shadow: 0 0 20px rgba(0, 245, 160, 0.3);
  }

  .portal-right:hover .portal-title {
    text-shadow: 0 0 20px rgba(139, 92, 246, 0.3);
  }

  .portal-desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
  }

  .portal-pane:hover .portal-desc {
    color: #FFFFFF;
  }

  /* Portal Action button */
  .portal-action {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-top: 0.75rem;
    transition: gap 0.3s ease;
  }

  .portal-left .portal-action {
    color: var(--be-primary);
  }

  .portal-right .portal-action {
    color: var(--fe-primary);
    justify-content: flex-end;
    width: 100%;
  }

  .portal-pane:hover .portal-action {
    gap: 12px;
  }

  .portal-arrow {
    width: 14px;
    height: 14px;
    transition: transform 0.3s ease;
  }

  .portal-pane:hover .portal-arrow {
    transform: translateX(4px);
  }

  /* CENTER FLOATING CORE */
  .portal-center-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 180px;
    height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 20;
    pointer-events: auto;
  }

  .core-outer-ring {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    animation: rotateRing 20s linear infinite;
    pointer-events: none;
  }

  .portal-center-core:hover .core-outer-ring {
    border-color: var(--accent-color);
    box-shadow: 0 0 20px rgba(0, 136, 255, 0.15);
  }

  .core-inner-sphere {
    width: 130px;
    height: 130px;
    background: rgba(13, 20, 35, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
    padding: 0.5rem;
    text-align: center;
  }

  .portal-center-core:hover .core-inner-sphere {
    border-color: var(--accent-color);
    box-shadow: 0 0 25px rgba(0, 136, 255, 0.25);
    transform: scale(1.05);
  }

  .core-avatar-wrap {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
    border: 1.5px solid var(--accent-color);
    margin-bottom: 0.5rem;
    box-shadow: 0 0 10px rgba(0, 136, 255, 0.2);
  }

  .core-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .core-details {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .core-handle {
    font-size: 0.72rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .core-status {
    font-size: 0.55rem;
    font-weight: 600;
    color: var(--accent-color);
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .status-blink {
    width: 4.5px;
    height: 4.5px;
    background: var(--be-primary);
    border-radius: 50%;
    animation: blinkGlow 1s infinite alternate;
  }

  .core-scroll-hint {
    position: absolute;
    bottom: -45px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-family: 'Outfit', sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    animation: bounceDown 1.5s infinite;
    pointer-events: none;
  }

  .hint-arrow {
    font-size: 0.8rem;
    color: var(--accent-color);
  }

  /* SYSTEMS CONTENT WRAPPER */
  .systems-content-wrapper {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 2rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 5rem;
    scroll-margin-top: 0;
  }

  @keyframes rotateRing {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes blinkGlow {
    0% { opacity: 0.3; }
    100% { opacity: 1; filter: drop-shadow(0 0 4px var(--be-primary)); }
  }

  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* Responsive Gateway stack */
  @media (max-width: 768px) {
    .split-gateway-hero {
      height: auto;
      min-height: 85vh;
      flex-direction: column;
      margin-top: 0;
    }

    .portal-pane {
      padding: 3rem 2rem;
      justify-content: center;
      height: 280px;
      flex: none !important;
    }

    .portal-center-core {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 140px;
      height: 140px;
    }

    .core-inner-sphere {
      width: 105px;
      height: 105px;
    }

    .core-scroll-hint {
      display: none;
    }
  }

  .meta-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-color);
    letter-spacing: 0.05em;
    margin-bottom: 0.8rem;
    display: inline-block;
  }

  .sys-title {
    font-size: 3.5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #FFFFFF 30%, var(--accent-color) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    margin-bottom: 1.8rem;
    line-height: 1.1;
  }

  .sys-section-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .sys-section-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  /* -------------------------------------------------------------
     CYBER DEVOPS OPERATIONAL DASHBOARD
     ------------------------------------------------------------- */
  .ops-dashboard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .ops-card {
    position: relative;
    overflow: hidden;
    background: rgba(7, 11, 19, 0.65);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2.25rem;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .ops-card:hover {
    border-color: var(--accent-color);
    box-shadow: 0 15px 35px rgba(0, 136, 255, 0.08);
  }

  .card-glow-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 10% 10%, rgba(0, 136, 255, 0.02) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  /* User profile details layout */
  .profile-user-info {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    position: relative;
    z-index: 2;
  }

  .avatar-container {
    position: relative;
    width: 90px;
    height: 90px;
    flex-shrink: 0;
  }

  .profile-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid var(--accent-color);
    object-fit: cover;
    background: #0C1017;
  }

  .user-status-dot {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #00F5A0;
    border: 2px solid #070B13;
    box-shadow: 0 0 8px #00F5A0;
    animation: pulseStatusIndicator 2s infinite alternate;
  }

  @keyframes pulseStatusIndicator {
    from { opacity: 0.7; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1.05); }
  }

  .user-details {
    display: flex;
    flex-direction: column;
  }

  .user-name {
    font-size: 1.7rem;
    font-weight: 800;
    color: #FFFFFF;
    margin: 0;
  }

  .user-handle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--accent-color);
    margin-bottom: 0.4rem;
  }

  .user-meta-stats {
    display: flex;
    gap: 10px;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }

  .user-bio {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .user-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .profile-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: #FFFFFF;
  }

  /* GitHub Heatmap styling */
  .github-contributions-box {
    margin-top: 1.8rem;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.25rem;
    position: relative;
    z-index: 2;
  }

  .contrib-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.8rem;
  }

  .contrib-legend {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .legend-cell {
    width: 9px;
    height: 9px;
    border-radius: 1.5px;
  }

  .github-commit-grid {
    display: grid;
    grid-template-rows: repeat(7, 9px);
    grid-auto-flow: column;
    gap: 3.5px;
    justify-content: start;
    overflow-x: auto;
    max-width: 100%;
    padding-bottom: 0.35rem;
  }

  .commit-cell {
    width: 9px;
    height: 9px;
    border-radius: 1.5px;
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.2s ease;
    cursor: pointer;
  }

  .commit-cell:hover {
    transform: scale(1.5);
    z-index: 10;
  }

  .commit-cell.empty, .legend-cell.empty { background: rgba(255, 255, 255, 0.05); }
  .commit-cell.low, .legend-cell.low { background: #1e1b4b; }
  .commit-cell.medium, .legend-cell.medium { background: #4338ca; }
  .commit-cell.high, .legend-cell.high { background: #8b5cf6; }
  .commit-cell.highest, .legend-cell.highest { background: #00f5a0; }

  /* Topology Net Card styles */
  .topology-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    z-index: 2;
    position: relative;
  }

  .top-status-indicator {
    color: #00F5A0;
    font-weight: 700;
    animation: blinkGlow 1.2s infinite alternate;
  }

  .top-title {
    color: var(--text-muted);
  }

  .canvas-container {
    position: relative;
    width: 100%;
    height: 250px;
    z-index: 2;
  }

  #cluster-topology-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }

  /* Telemetry dynamic hover popover */
  .topology-popover {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(7, 11, 19, 0.9);
    border: 1px solid rgba(0, 136, 255, 0.25);
    border-radius: 8px;
    padding: 0.85rem 1.1rem;
    min-width: 160px;
    pointer-events: none;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    font-family: 'JetBrains Mono', monospace;
    z-index: 10;
  }

  .topology-popover.active {
    opacity: 1;
    transform: translateY(0);
  }

  .pop-header {
    font-size: 0.58rem;
    color: var(--text-muted);
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .pop-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .pop-metric {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    margin-bottom: 2px;
  }

  .pop-metric .m-label {
    color: var(--text-muted);
  }

  .pop-metric .m-val {
    color: #FFFFFF;
    font-weight: bold;
  }
  .pop-metric .m-val.green {
    color: #00F5A0;
  }

  /* -------------------------------------------------------------
     LIVE METRICS & CLI TERMINAL STREAM
     ------------------------------------------------------------- */
  .live-ops-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .ops-metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .metric-gauge-card {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .metric-top-row {
    display: flex;
    justify-content: space-between;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  .metric-val {
    color: #FFFFFF;
    transition: color 0.3s ease;
  }

  .bar-progress-bg {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar-progress-fill {
    height: 100%;
    background: var(--accent-color);
    border-radius: 3px;
    transition: width 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }


  /* -------------------------------------------------------------
     SYSTEMS / PINNED REPOSITORIES LIST
     ------------------------------------------------------------- */
  .systems-projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .sys-project-card {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2.5rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: border-color 0.4s ease, transform 0.4s ease, box-shadow 0.4s ease;
  }

  .sys-project-card:hover {
    border-color: var(--accent-color);
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2), 0 0 30px rgba(0, 136, 255, 0.05);
  }

  .project-head-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .sys-project-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 700;
    color: #00F5A0;
    background: rgba(0, 245, 160, 0.1);
    border: 1px solid rgba(0, 245, 160, 0.2);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
  }
  .sys-project-badge.transcoder {
    color: #8B5CF6;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
  }

  .telemetry-latency {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .sys-project-header h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .sys-project-summary {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Interactive architecture tab switchers */
  .arch-switcher {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.15);
    margin-top: 0.5rem;
  }

  .arch-tab-btns {
    display: flex;
    border-bottom: 1px solid var(--border-color);
    background: rgba(255, 255, 255, 0.01);
  }

  .arch-btn {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    padding: 0.75rem 0.5rem;
    font-family: var(--sys-font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    border-right: 1px solid var(--border-color);
  }

  .arch-btn:last-child {
    border-right: none;
  }

  .arch-btn:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.02);
  }

  .arch-btn.active {
    color: #FFFFFF;
    background: rgba(0, 136, 255, 0.15);
    box-shadow: inset 0 -2px 0 var(--accent-color);
  }

  .arch-content {
    padding: 1.25rem;
    min-height: 140px;
  }

  .arch-pane {
    display: none;
    flex-direction: column;
    gap: 0.75rem;
  }

  .arch-pane.active {
    display: flex;
    animation: fadeInPane 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeInPane {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tech-stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-tag {
    font-size: 0.7rem;
    font-weight: 600;
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-color);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .pane-text {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* -------------------------------------------------------------
     CYBER CONTACT HUBS (NO EMAIL FORM)
     ------------------------------------------------------------- */
  .cyber-contact-section {
    border-top: 1px solid var(--border-color);
    padding-top: 4rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  /* Left Side: Mock Interactive SSH Terminal */
  .ssh-terminal-card {
    background: #070B13;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    position: relative;
  }

  .terminal-card-header {
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .term-dots {
    display: flex;
    gap: 6px;
  }

  .t-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .t-dot.red { background: #FF5F56; }
  .t-dot.yellow { background: #FFBD2E; }
  .t-dot.green { background: #27C93F; }

  .term-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .terminal-card-body {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .term-info-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0;
  }

  .ssh-command-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(0, 245, 160, 0.2);
    border-radius: 8px;
    padding: 1.2rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ssh-command-box:hover {
    border-color: #00F5A0;
