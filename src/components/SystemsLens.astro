  .node-icon-wrapper.gh { background: #24292F; }
  .node-icon-wrapper.li { background: #0A66C2; }
  .node-icon-wrapper.tg { background: #229ED9; }
  .node-icon-wrapper.ds { background: #5865F2; }

  .node-details {
    display: flex;
    flex-direction: column;
